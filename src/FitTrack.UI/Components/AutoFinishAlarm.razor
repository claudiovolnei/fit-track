@inject IJSRuntime JS

@if (_isActive)
{
    <div class="alarm-banner" role="alert" aria-live="assertive">
        <div class="alarm-content">
            <AppIcon Name="bell" Size="24" />
            <span>Seu treino foi encerrado automaticamente pelo sistema.</span>
        </div>
        <button class="btn btn-danger btn-sm" @onclick="StopAlarm" aria-label="Parar alarme">
            <AppIcon Name="stop" Size="16" />
            Parar
        </button>
    </div>
}

@code {
    private bool _isActive = false;
    private System.Timers.Timer? _timer;

    /// <summary>
    /// Only activates when the caller explicitly signals an auto-finish event.
    /// </summary>
    [Parameter]
    public bool ShowAlarm { get; set; } = false;

    protected override async Task OnParametersSetAsync()
    {
        if (ShowAlarm && !_isActive)
        {
            await StartAlarmAsync();
        }
        else if (!ShowAlarm && _isActive)
        {
            await StopAlarm();
        }
    }

    private async Task StartAlarmAsync()
    {
        _isActive = true;
        await JS.InvokeVoidAsync("startAutoFinishAlarm");

        _timer = new System.Timers.Timer(15000);
        _timer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(StopAlarm);
            _timer?.Stop();
        };
        _timer.AutoReset = false;
        _timer.Start();
    }

    private async Task StopAlarm()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _timer = null;
        _isActive = false;
        await JS.InvokeVoidAsync("stopAutoFinishAlarm");
    }
}
