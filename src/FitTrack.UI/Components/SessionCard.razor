@* A workout from the history: when it was, how long it lasted and what was logged. *@

<article class="card session-card">
    <div class="session-head">
        <div class="date-block">
            <span class="date-day">@Session.WorkoutDate.Day.ToString("00")</span>
            <span class="date-month">@DisplayText.ShortMonth(Session.WorkoutDate)</span>
        </div>

        <div class="session-title">
            <h3>Treino de @DisplayText.LongDate(Session.WorkoutDate)</h3>
            <p class="muted">
                @if (Session.IsRunning)
                {
                    <span>Em andamento desde @Session.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                }
                else
                {
                    <span>@DisplayText.Duration(Session.DurationSeconds) · início às @Session.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                }
            </p>
        </div>

        <span class="chip @(Session.IsRunning ? "chip--accent" : "chip--success")">
            @(Session.IsRunning ? "Em andamento" : "Concluído")
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Session.WorkoutSeriesName))
    {
        <div class="user-status" style="margin-top: 12px;">
            <span class="chip chip--accent">
                <AppIcon Name="layers" Size="14" />
                Série: @Session.WorkoutSeriesName
            </span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Session.Intensity))
    {
        <div class="user-status" style="margin-top: 12px;">
            <span class="chip chip--accent">
                <AppIcon Name="sparkles" Size="14" />
                @DisplayText.IntensityLabel(Session.Intensity)
            </span>
        </div>
    }

    <p class="muted" style="margin: 12px 0 0; font-size: 0.84rem;">
        <strong>Sobre o treino:</strong> @(string.IsNullOrWhiteSpace(Session.Notes) ? "não informado" : Session.Notes)
    </p>

    @if (Session.Sets.Count == 0)
    {
        <p class="muted" style="margin-top: 14px; font-size: 0.86rem;">Nenhuma série registrada.</p>
    }
    else
    {
        <div class="summary-strip">
            <span class="summary-item">
                <AppIcon Name="dumbbell" Size="15" />
                @Session.Sets.Count @(Session.Sets.Count == 1 ? "série" : "séries")
            </span>
            <span class="summary-item">
                <AppIcon Name="scale" Size="15" />
                @DisplayText.Volume(Volume)
            </span>
            <span class="summary-item">
                <AppIcon Name="timer" Size="15" />
                @DisplayText.Duration(Session.DurationSeconds)
            </span>
        </div>

        <SessionSetList Session="Session" ExerciseNames="ExerciseNames"
                        ExpandedKeys="ExpandedKeys" GroupToggled="GroupToggled" />
    }

    @if (Session.Volume is { } volume)
    {
        <div class="volume-comparison">
            <span>Feito (média) <strong>@DisplayText.Load(volume.PerformedKilograms)</strong></span>
            <span>Prescrito <strong>@DisplayText.Load(volume.PrescribedKilograms)</strong></span>
            <span class="@DeltaClass(volume.DeltaKilograms)">
                Aumento <strong>@DisplayText.SignedLoad(volume.DeltaKilograms)</strong>
                @if (volume.DeltaPercent is { } percent)
                {
                    <text> (@DisplayText.SignedPercent(percent))</text>
                }
            </span>
            @if (Session.IsRunning)
            {
                <span>parcial</span>
            }
        </div>

        @if (volume.Exercises.Count > 0)
        {
            <button type="button" class="exercise-toggle volume-exercises-toggle"
                    aria-expanded="@(VolumeExpanded ? "true" : "false")"
                    @onclick="() => VolumeToggled.InvokeAsync()">
                <AppIcon Name="chevron-down" Size="14" />
                <span>@(VolumeExpanded ? "Esconder por exercício" : $"Ver por exercício ({volume.Exercises.Count})")</span>
            </button>

            @if (VolumeExpanded)
            {
                <div class="volume-exercises">
                    @foreach (var exercise in volume.Exercises)
                    {
                        <span>
                            <strong>@exercise.ExerciseName</strong>
                            @ExerciseVolumeText(exercise)
                        </span>
                    }
                </div>
            }
        }
    }
    else
    {
        <div class="volume-comparison">
            <span>Volume feito <strong>@DisplayText.Volume(Volume)</strong></span>
            <span>sem prescrição para comparar</span>
            @if (Session.IsRunning)
            {
                <span>parcial</span>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired]
    public WorkoutSessionResponse Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<Guid, string> ExerciseNames { get; set; } = null!;

    /// <summary>
    /// The expanded group keys, forwarded to the sets list. The card holds no state of its own;
    /// defaults keep the card working standalone with every group collapsed.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<string> ExpandedKeys { get; set; } = [];

    [Parameter]
    public EventCallback<string> GroupToggled { get; set; }

    /// <summary>Whether the per-exercise volume list is open. The screen owns the state.</summary>
    [Parameter]
    public bool VolumeExpanded { get; set; }

    /// <summary>Reports that the user toggled the per-exercise volume list.</summary>
    [Parameter]
    public EventCallback VolumeToggled { get; set; }

    private decimal Volume =>
        Session.Sets.Sum(set => set.LoadKilograms * set.Repetitions);

    private static string DeltaClass(decimal delta) =>
        delta > 0m ? "is-up" : delta < 0m ? "is-down" : string.Empty;

    private static string ExerciseVolumeText(ExerciseVolumeResponse exercise) => exercise.Status switch
    {
        "notPerformed" => $"não executado · prescrito {DisplayText.Load(exercise.PrescribedKilograms)}",
        "notPrescribed" => $"não prescrito · feito {DisplayText.Load(exercise.PerformedKilograms)}",
        "bodyweight" => $"prescrição sem carga · feito {DisplayText.Load(exercise.PerformedKilograms)}",
        _ => $"prescrito {DisplayText.Load(exercise.PrescribedKilograms)} · feito {DisplayText.Load(exercise.PerformedKilograms)} (média) · {DeltaText(exercise)}",
    };

    private static string DeltaText(ExerciseVolumeResponse exercise) =>
        exercise.DeltaPercent is { } percent
            ? $"{DisplayText.SignedLoad(exercise.DeltaKilograms)} ({DisplayText.SignedPercent(percent)})"
            : DisplayText.SignedLoad(exercise.DeltaKilograms);
}
