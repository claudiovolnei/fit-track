@page "/athletes/{UserId:guid}/workouts"
@attribute [Authorize(Roles = "PersonalTrainer")]
@inject FitTrackApiClient Api

<PageTitle>Treinos do atleta — FitTrack</PageTitle>

<a class="back-link" href="/athletes">
    <AppIcon Name="arrow-left" Size="16" />
    Atletas
</a>

<PageHeader Eyebrow="Histórico do atleta"
            Title="@($"Treinos de {DisplayText.NameFromEmail(_email)}")"
            Subtitle="@(_email ?? UserId.ToString())" />

@if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}

<SearchField Value="@_search" ValueChanged="SearchAsync"
             Placeholder="Buscar treino por nome"
             AriaLabel="Buscar treino por nome" />

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando treinos…</span>
    </div>
}
else if (_totalCount == 0)
{
    <div class="empty-state">
        <AppIcon Name="@(HasSearch ? "search" : "history")" Size="28" />
        <h2>@(HasSearch ? "Nada encontrado" : "Nada registrado ainda")</h2>
        <p>@(HasSearch ? "Tente outro nome de treino." : "Este atleta ainda não iniciou nenhum treino.")</p>
        @if (HasSearch)
        {
            <button class="btn btn-secondary" type="button" @onclick="ClearSearchAsync">Limpar busca</button>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}
else
{
    @if (_summary is not null)
    {
        <div class="stat-grid" style="margin-top: 22px; margin-bottom: 22px;">
            <article class="stat">
                <span class="stat-label">Treinos</span>
                <span class="stat-value">@_summary.SessionCount</span>
            </article>
            <article class="stat">
                <span class="stat-label">Séries</span>
                <span class="stat-value">@_summary.SetCount</span>
            </article>
            <article class="stat">
                <span class="stat-label">Volume feito</span>
                <span class="stat-value">
                    @DisplayText.Volume(_summary.PerformedKilograms)
                    <small>Prescrito @DisplayText.Volume(_summary.PrescribedKilograms)</small>
                </span>
            </article>
            <article class="stat">
                <span class="stat-label">Aumento</span>
                <span class="stat-value @(_summary.DeltaKilograms > 0 ? "is-up" : _summary.DeltaKilograms < 0 ? "is-down" : "")">
                    @DisplayText.SignedVolume(_summary.DeltaKilograms)
                    @if (_summary.DeltaPercent is { } percent)
                    {
                        <small> (@DisplayText.SignedPercent(percent))</small>
                    }
                </span>
            </article>
        </div>
    }

    @foreach (var session in _sessions)
    {
        <SessionCard @key="session.Id" Session="session" ExerciseNames="_exerciseNames" />
    }

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}

@code {
    private const int PageSize = 10;

    [Parameter]
    public Guid UserId { get; set; }

    private IReadOnlyList<WorkoutSessionResponse> _sessions = [];
    private IReadOnlyDictionary<Guid, string> _exerciseNames = new Dictionary<Guid, string>();
    private WorkoutVolumeSummaryResponse? _summary;
    private string? _email;
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private int _page = 1;
    private int _totalCount;
    private int _loadVersion;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var exercises = await Api.GetExercisesAsync();
            _exerciseNames = exercises.ToDictionary(exercise => exercise.Id, exercise => exercise.Name);

            var athletes = await Api.GetAthletesAsync();
            _email = athletes.FirstOrDefault(athlete => athlete.UserId == UserId)?.Email;
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // The latest request wins; an older answer arriving late must not replace the page on screen.
        var version = ++_loadVersion;
        _loading = true;
        _error = null;

        try
        {
            var history = await Api.GetAthleteWorkoutsPageAsync(UserId, _search, _page, PageSize);

            if (version != _loadVersion)
            {
                return;
            }

            _sessions = history.Items;
            _summary = history.Summary;
            _totalCount = history.TotalCount;
        }
        catch (ApiException exception)
        {
            if (version != _loadVersion)
            {
                return;
            }

            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private async Task SearchAsync(string value)
    {
        _search = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _page = 1;
        await LoadAsync();
    }
}
