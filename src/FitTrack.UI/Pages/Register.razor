@page "/register"
@inject FitTrackApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Create account</PageTitle>

<h1>Create account</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="register-email">Email</label>
        <InputText id="register-email" type="email" @bind-Value="_model.Email" />
        <ValidationMessage For="() => _model.Email" />
    </div>

    <div class="field">
        <label for="register-password">Password</label>
        <InputText id="register-password" type="password" @bind-Value="_model.Password" />
        <ValidationMessage For="() => _model.Password" />
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Creating…" : "Create account")</button>
</EditForm>

<p class="muted">Already have an account? <a href="/login">Sign in</a>.</p>

@code {
    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            await Api.RegisterAsync(new RegisterAccountRequest(_model.Email, _model.Password));

            var login = await Api.LoginAsync(new LoginRequest(_model.Email, _model.Password));
            await Session.SignInAsync(login.AccessToken);

            Navigation.NavigateTo("/workouts");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Model
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = string.Empty;
    }
}
