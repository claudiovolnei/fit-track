@page "/register"
@inject FitTrackApiClient Api
@inject ToastService Toasts
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Criar conta — FitTrack</PageTitle>

<div class="auth-page">
    <AuthAside Eyebrow="Comece agora"
               Title="Treine com clareza desde o primeiro dia."
               Text="Crie sua conta para acompanhar a ficha do seu personal e registrar cada série da academia."
               Points="@(new[] { "Cadastro rápido e gratuito", "Seus treinos organizados por série", "Cada série registrada no histórico" })" />

    <section class="auth-card card">
        <p class="eyebrow">Nova conta</p>
        <h1>Criar conta</h1>
        <p class="muted">Leva menos de um minuto.</p>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="register-name">Nome</label>
                <InputText id="register-name" autocomplete="name" placeholder="Como você quer ser chamado"
                           @bind-Value="_model.Name" />
                <ValidationMessage For="() => _model.Name" />
            </div>

            <div class="field">
                <label for="register-email">E-mail</label>
                <InputText id="register-email" type="email" autocomplete="email" placeholder="voce@exemplo.com"
                           @bind-Value="_model.Email" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="field">
                <label for="register-password">Senha</label>
                <InputText id="register-password" type="password" autocomplete="new-password" placeholder="Mínimo de 8 caracteres"
                           @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            <button class="btn btn-primary btn-block" type="submit" disabled="@_busy">
                @(_busy ? "Criando conta…" : "Criar conta")
            </button>
        </EditForm>

        <p class="auth-switch">
            Já tem uma conta? <a href="/login">Entrar</a>
        </p>
    </section>
</div>

@code {
    private readonly Model _model = new();
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;

        try
        {
            await Api.RegisterAsync(new RegisterAccountRequest(_model.Name, _model.Email, _model.Password));

            var login = await Api.LoginAsync(new LoginRequest(_model.Email, _model.Password));
            await Session.SignInAsync(login.AccessToken);

            Navigation.NavigateTo("/today");
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Model
    {
        [Required(ErrorMessage = "Informe seu nome.")]
        [MaxLength(80, ErrorMessage = "Use no máximo 80 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Crie uma senha.")]
        [MinLength(8, ErrorMessage = "Use pelo menos 8 caracteres.")]
        public string Password { get; set; } = string.Empty;
    }
}
