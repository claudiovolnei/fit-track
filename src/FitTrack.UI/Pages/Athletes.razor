@page "/athletes"
@attribute [Authorize(Roles = "PersonalTrainer,Admin")]
@inject FitTrackApiClient Api
@inject NavigationManager Nav
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthState

<PageTitle>Atletas — FitTrack</PageTitle>

<PageHeader Eyebrow="Gestão"
            Title="Atletas"
            Subtitle="@(_isAdmin
                ? "Todo atleta e seu personal. Vincule quem ainda não tem personal e desvincule de qualquer roster."
                : "Seus alunos ficam aqui e cada um tem sua própria série. Busque acima para vincular um atleta sem personal a você.")">
    <Actions>
        <a class="btn btn-secondary" href="/series">
            <AppIcon Name="layers" Size="18" />
            Ver séries
        </a>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}

<SearchField Value="@_search" ValueChanged="SearchAsync"
             Placeholder="@(_isAdmin
                ? "Buscar atleta por e-mail"
                : "Buscar atletas sem personal para vincular a você")"
             AriaLabel="Buscar atleta por e-mail" />

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando atletas…</span>
    </div>
}
else if (_totalCount == 0)
{
    <div class="empty-state">
        <AppIcon Name="@(HasSearch ? "search" : "users")" Size="28" />
        <h2>@(HasSearch ? "Nada encontrado" : "Nenhum atleta ainda")</h2>
        <p>
            @(HasSearch
                ? "Tente outro e-mail."
                : _isAdmin
                    ? "Quando uma conta com perfil de atleta for criada, ela aparece aqui."
                    : "Você ainda não tem alunos. Busque um atleta sem personal acima e vincule-o a você.")
        </p>
        @if (HasSearch)
        {
            <button class="btn btn-secondary" type="button" @onclick="ClearSearchAsync">Limpar busca</button>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}
else
{
    <div class="card-grid" style="margin-top: 22px;">
        @foreach (var athlete in _athletes)
        {
            <article class="card athlete-card" @key="athlete.UserId">
                <div class="athlete-head">
                    <span class="avatar avatar--lg">@DisplayText.Initials(athlete.Email)</span>
                    <div style="min-width: 0;">
                        <h2>@DisplayText.NameFromEmail(athlete.Email)</h2>
                        <p>@athlete.Email</p>
                    </div>
                </div>

                <div class="athlete-status">
                    @if (_isAdmin)
                    {
                        if (athlete.PersonalTrainerEmail is null)
                        {
                            <span class="chip">Sem personal</span>
                        }
                        else
                        {
                            <span class="chip chip--accent">
                                Personal: @DisplayText.NameFromEmail(athlete.PersonalTrainerEmail)
                            </span>
                        }
                    }
                    else if (athlete.SeriesId is null)
                    {
                        <span class="chip">Sem série vinculada</span>
                    }
                    else
                    {
                        <span class="chip chip--accent">@athlete.SeriesName</span>
                        @if (athlete.DaysRemaining == 0)
                        {
                            <span class="chip chip--danger">Série vencida</span>
                        }
                        else
                        {
                            <span class="muted" style="font-size: 0.76rem;">
                                @athlete.DaysRemaining @(athlete.DaysRemaining == 1 ? "dia restante" : "dias restantes")
                            </span>
                        }
                    }
                </div>

                @if (_linkingFor == athlete.UserId)
                {
                    <div class="inline-form" style="margin-top: 12px;">
                        <div class="field">
                            <label for="trainer-for-@athlete.UserId">Personal que recebe o atleta</label>
                            <select id="trainer-for-@athlete.UserId" @bind="_linkTrainerId">
                                @foreach (var trainer in _trainers)
                                {
                                    <option value="@trainer.UserId">@DisplayText.NameFromEmail(trainer.Email)</option>
                                }
                            </select>
                        </div>
                        <div class="actions">
                            <button class="btn btn-primary btn-sm" type="button"
                                    disabled="@(_busy || _trainers.Count == 0)"
                                    @onclick="() => LinkAsync(athlete.UserId)">
                                <AppIcon Name="plus" Size="16" />
                                Vincular
                            </button>
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                    @onclick="CancelLinkAsync">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }

                @if (_creatingFor == athlete.UserId)
                {
                    <div class="inline-form" style="margin-top: 12px;">
                        <div class="field">
                            <label for="series-for-@athlete.UserId">Nome da série</label>
                            <input id="series-for-@athlete.UserId" maxlength="80" placeholder="Ex.: Hipertrofia — 4 dias"
                                   @bind="_newSeriesName" @bind:event="oninput" />
                        </div>
                        <div class="actions">
                            <button class="btn btn-primary btn-sm" type="button"
                                    disabled="@(_busy || string.IsNullOrWhiteSpace(_newSeriesName))"
                                    @onclick="() => CreateForAthleteAsync(athlete.UserId)">
                                <AppIcon Name="plus" Size="16" />
                                Criar série
                            </button>
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                    @onclick="CancelCreateAsync">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }

                <div class="actions">
                    @if (_isAdmin)
                    {
                        @if (athlete.PersonalTrainerEmail is null)
                        {
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                    @onclick="() => StartLinkAsync(athlete.UserId)">
                                <AppIcon Name="plus" Size="16" />
                                Vincular personal
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm" type="button" disabled="@_busy"
                                    @onclick="() => UnlinkAsync(athlete.UserId)">
                                <AppIcon Name="logout" Size="16" />
                                Desvincular
                            </button>
                        }
                    }
                    else if (CandidatesMode)
                    {
                        <button class="btn btn-primary btn-sm" type="button" disabled="@_busy"
                                @onclick="() => LinkAsync(athlete.UserId)">
                            <AppIcon Name="plus" Size="16" />
                            Vincular a mim
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                @onclick="() => StartCreateAsync(athlete.UserId)">
                            <AppIcon Name="plus" Size="16" />
                            Nova série para este atleta
                        </button>

                        <button class="btn btn-danger btn-sm" type="button" disabled="@_busy"
                                @onclick="() => UnlinkAsync(athlete.UserId)">
                            <AppIcon Name="logout" Size="16" />
                            Desvincular
                        </button>
                    }

                    @if (!_isAdmin)
                    {
                        <a class="btn btn-secondary" href="/athletes/@athlete.UserId/workouts">
                            Ver treinos
                            <AppIcon Name="chevron-right" Size="16" />
                        </a>
                    }
                </div>
            </article>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}

@code {
    private const int PageSize = 12;

    private bool _isAdmin;

    // Admin: every athlete, with the trainer each one answers to. Personal: the own roster by
    // default — with a search on, the read flips to candidates, athletes linked to nobody.
    private bool CandidatesMode => !_isAdmin && HasSearch;

    private IReadOnlyList<AthleteRow> _athletes = [];
    private IReadOnlyList<UserAccountResponse> _trainers = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private Guid? _creatingFor;
    private Guid? _linkingFor;
    private Guid _linkTrainerId;
    private string _newSeriesName = string.Empty;
    private string _search = string.Empty;
    private int _page = 1;
    private int _totalCount;
    private int _loadVersion;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isAdmin = state.User.IsInRole("Admin");

        if (_isAdmin)
        {
            await LoadTrainersAsync();
        }

        await ReloadAsync();
    }

    private async Task LoadTrainersAsync()
    {
        try
        {
            var result = await Api.GetUsersPageAsync(null, 1, 100, "PersonalTrainer");
            _trainers = result.Items;
        }
        catch (ApiException)
        {
            // The select stays empty; the admin falls back to asking for the trainer by role later.
        }
    }

    private async Task SearchAsync(string value)
    {
        _search = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _page = 1;
        await ReloadAsync();
    }

    private void StartLinkAsync(Guid userId)
    {
        _linkingFor = userId;

        _linkTrainerId = _trainers.Count > 0
            ? _trainers[0].UserId
            : Guid.Empty;
    }

    private void CancelLinkAsync()
    {
        _linkingFor = null;
    }

    private void StartCreateAsync(Guid userId)
    {
        _creatingFor = userId;
        _newSeriesName = string.Empty;
    }

    private void CancelCreateAsync()
    {
        _creatingFor = null;
        _newSeriesName = string.Empty;
    }

    private async Task LinkAsync(Guid userId) =>
        await RunAsync(async () =>
        {
            var trainerId = _isAdmin ? _linkTrainerId : (Guid?)null;

            await Api.LinkTrainerAsync(userId, trainerId);

            CancelLinkAsync();
            await ReloadAsync();
        });

    private async Task UnlinkAsync(Guid userId) =>
        await RunAsync(async () =>
        {
            await Api.UnlinkTrainerAsync(userId);
            await ReloadAsync();
        });

    private async Task CreateForAthleteAsync(Guid userId) =>
        await RunAsync(async () =>
        {
            var created = await Api.CreateWorkoutSeriesAsync(new SetWorkoutSeriesNameRequest(_newSeriesName, userId));

            CancelCreateAsync();

            // Opens the dedicated screen so the trainer composes the workouts (A–E) right away.
            Nav.NavigateTo($"/series/{created.Id}");
        });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        // The last request made owns the screen; a late answer from a previous search is discarded.
        var version = ++_loadVersion;
        _loading = true;
        _error = null;

        try
        {
            var result = await Api.GetAthletesPageAsync(_search, _page, PageSize, CandidatesMode);

            if (version != _loadVersion)
            {
                return;
            }

            _athletes =
            [
                .. result.Items.Select(athlete => new AthleteRow
                {
                    UserId = athlete.UserId,
                    Email = athlete.Email,
                    SeriesId = athlete.WorkoutSeriesId,
                    SeriesName = athlete.WorkoutSeriesName,
                    DaysRemaining = athlete.DaysRemaining,
                    PersonalTrainerEmail = athlete.PersonalTrainerEmail,
                }),
            ];

            _totalCount = result.TotalCount;
        }
        catch (ApiException exception)
        {
            if (version != _loadVersion)
            {
                return;
            }

            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private sealed class AthleteRow
    {
        public Guid UserId { get; init; }

        public string Email { get; init; } = string.Empty;

        public Guid? SeriesId { get; init; }

        public string? SeriesName { get; init; }

        public int DaysRemaining { get; init; }

        public string? PersonalTrainerEmail { get; init; }
    }
}
