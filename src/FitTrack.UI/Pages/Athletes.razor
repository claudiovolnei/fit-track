@page "/athletes"
@attribute [Authorize(Roles = "PersonalTrainer")]
@inject FitTrackApiClient Api

<PageTitle>Atletas — FitTrack</PageTitle>

<PageHeader Eyebrow="Gestão"
            Title="Atletas"
            Subtitle="Vincule uma série a cada atleta. Uma nova vinculação substitui a anterior e reinicia o prazo de 60 dias.">
    <Actions>
        <a class="btn btn-secondary" href="/series">
            <AppIcon Name="layers" Size="18" />
            Ver séries
        </a>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando atletas…</span>
    </div>
}
else if (_athletes.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="users" Size="28" />
        <h2>Nenhum atleta ainda</h2>
        <p>Quando uma conta com perfil de atleta for criada, ela aparece aqui para receber uma série.</p>
    </div>
}
else
{
    @if (_series.Count == 0)
    {
        <div class="alert alert--info">
            <AppIcon Name="info" Size="18" />
            <span>
                Você ainda não tem séries. <a href="/series">Crie uma</a> para poder vincular aos atletas.
            </span>
        </div>
    }

    <div class="card-grid">
        @foreach (var athlete in _athletes)
        {
            <article class="card athlete-card" @key="athlete.UserId">
                <div class="athlete-head">
                    <span class="avatar avatar--lg">@DisplayText.Initials(athlete.Email)</span>
                    <div style="min-width: 0;">
                        <h2>@DisplayText.NameFromEmail(athlete.Email)</h2>
                        <p>@athlete.Email</p>
                    </div>
                </div>

                <div class="athlete-status">
                    @if (athlete.SeriesId is null)
                    {
                        <span class="chip">Sem série vinculada</span>
                    }
                    else
                    {
                        <span class="chip chip--accent">@athlete.SeriesName</span>
                        @if (athlete.DaysRemaining == 0)
                        {
                            <span class="chip chip--danger">Série vencida</span>
                        }
                        else
                        {
                            <span class="muted" style="font-size: 0.76rem;">
                                @athlete.DaysRemaining @(athlete.DaysRemaining == 1 ? "dia restante" : "dias restantes")
                            </span>
                        }
                    }
                </div>

                @if (_series.Count > 0)
                {
                    <div class="field">
                        <label for="series-for-@athlete.UserId">Série</label>
                        <select id="series-for-@athlete.UserId" @bind="athlete.SelectedSeriesId">
                            @foreach (var series in _series)
                            {
                                <option value="@series.Id">@series.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="actions">
                    @if (_series.Count > 0)
                    {
                        <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="() => AssignAsync(athlete)">
                            <AppIcon Name="check" Size="18" />
                            @(athlete.SeriesId is null ? "Vincular série" : "Trocar série")
                        </button>
                    }

                    <a class="btn btn-secondary" href="/athletes/@athlete.UserId/workouts">
                        Ver treinos
                        <AppIcon Name="chevron-right" Size="16" />
                    </a>
                </div>
            </article>
        }
    </div>
}

@code {
    private IReadOnlyList<AthleteRow> _athletes = [];
    private IReadOnlyList<WorkoutSeriesResponse> _series = [];
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() => await RunAsync(ReloadAsync);

    private async Task AssignAsync(AthleteRow athlete) =>
        await RunAsync(async () =>
        {
            await Api.AssignWorkoutSeriesAsync(
                athlete.SelectedSeriesId,
                new AssignWorkoutSeriesRequest(athlete.UserId));

            await ReloadAsync();
        });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        _series = await Api.GetWorkoutSeriesAsync();

        var athletes = await Api.GetAthletesAsync();

        _athletes =
        [
            .. athletes.Select(athlete => new AthleteRow
            {
                UserId = athlete.UserId,
                Email = athlete.Email,
                SeriesId = athlete.WorkoutSeriesId,
                SeriesName = athlete.WorkoutSeriesName,
                DaysRemaining = athlete.DaysRemaining,
                SelectedSeriesId = athlete.WorkoutSeriesId ?? _series.FirstOrDefault()?.Id ?? Guid.Empty,
            }),
        ];

        _loading = false;
    }

    private sealed class AthleteRow
    {
        public Guid UserId { get; init; }

        public string Email { get; init; } = string.Empty;

        public Guid? SeriesId { get; init; }

        public string? SeriesName { get; init; }

        public int DaysRemaining { get; init; }

        public Guid SelectedSeriesId { get; set; }
    }
}
