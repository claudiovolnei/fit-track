@page "/today"
@attribute [Authorize]
@implements IDisposable
@inject FitTrackApiClient Api
@inject ToastService Toasts

<PageTitle>Hoje — FitTrack</PageTitle>

<PageHeader Eyebrow="@DisplayText.Today"
            Title="Hoje"
            Subtitle="Escolha o treino do dia e registre cada série." />

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando seu treino…</span>
    </div>
}
else if (_mine is null)
{
    <div class="empty-state">
        <AppIcon Name="layers" Size="28" />
        <h2>Nenhuma série vinculada</h2>
        <p>Seu personal ainda não vinculou uma série. Fale com ele para receber os treinos.</p>
    </div>
}
else if (_mine.Series.Workouts.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="calendar" Size="28" />
        <h2>Série sem treinos</h2>
        <p>A série <strong>@_mine.Series.Name</strong> ainda não tem treinos montados.</p>
    </div>
}
else
{
    <section class="series-banner">
        <div class="series-banner-main">
            <span class="chip @(_mine.IsExpired ? "chip--danger" : "chip--accent")">
                @(_mine.IsExpired ? "Série vencida" : "Série ativa")
            </span>
            <h2>@_mine.Series.Name</h2>
            <p class="trainer-line">
                <UserAvatar AvatarUrl="@_trainerAvatarUrl" NameOrEmail="@_mine.TrainerName" Size="24" />
                Personal <strong>@_mine.TrainerName</strong> ·
                @_mine.Series.Workouts.Count @(_mine.Series.Workouts.Count == 1 ? "treino disponível" : "treinos disponíveis")
            </p>
        </div>

        <div class="series-term">
            <div class="series-term-head">
                <span>@(_mine.IsExpired ? "Vencida" : "Validade")</span>
                <strong>@TermPercent%</strong>
            </div>
            <div class="progress">
                <span style="width: @TermPercent%"></span>
            </div>
            @if (!_mine.IsExpired)
            {
                <p class="muted" style="margin-top: 7px; font-size: 0.74rem;">
                    @_mine.DaysRemaining @(_mine.DaysRemaining == 1 ? "dia restante" : "dias restantes")
                </p>
            }
        </div>
    </section>

    <div class="workout-list">
        @foreach (var workout in _mine.Series.Workouts)
        {
            <article class="card workout-card" @key="workout.Id">
                <div class="workout-head">
                    <span class="label-badge">@workout.Label</span>

                    <div class="workout-title">
                        <h2>@workout.Name</h2>
                        <p class="muted">@workout.Exercises.Count @(workout.Exercises.Count == 1 ? "exercício" : "exercícios")</p>
                    </div>

                    @if (workout.Today is null)
                    {
                        <span class="chip">A fazer</span>
                    }
                    else if (workout.Today.IsRunning)
                    {
                        <span class="chip chip--accent">
                            Em andamento
                            <span class="pulse-dot"></span>
                        </span>
                    }
                    else
                    {
                        <span class="chip chip--success">Concluído</span>
                    }
                </div>

                @if (workout.Today is null)
                {
                    <ul class="exercise-list">
                        @foreach (var prescribed in workout.Exercises)
                        {
                            <li class="exercise-row">
                                <div>
                                    <span class="exercise-name">@prescribed.ExerciseName</span>
                                    <span class="exercise-meta">@prescribed.MuscleGroupName</span>
                                </div>
                                <div class="exercise-prescription">
                                    <strong>@prescribed.Sets × @prescribed.Repetitions</strong>
                                    <span>@Load(prescribed.LoadKilograms)</span>
                                    @if (prescribed.RestSeconds > 0)
                                    {
                                        <button type="button" class="chip chip--accent rest-chip"
                                                aria-label="@RestLabel(prescribed.ExerciseName, prescribed.RestSeconds)"
                                                @onclick="() => OpenRestTimer(prescribed.ExerciseName, prescribed.RestSeconds)">
                                            ⏱ @(prescribed.RestSeconds)s
                                        </button>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    @if (_mine.IsExpired)
                    {
                        <div class="alert alert--error" style="margin: 16px 0 0;">
                            <AppIcon Name="info" Size="18" />
                            <span>
                                A série venceu, então não dá para começar um treino novo. Um treino já
                                iniciado ainda pode ser finalizado.
                            </span>
                        </div>
                    }
                    else if (HasWorkoutToday)
                    {
                        <div class="alert alert--info" style="margin: 16px 0 0;">
                            <AppIcon Name="info" Size="18" />
                            <span>
                                Você já treinou hoje. Só dá para fazer um treino por dia — o próximo fica
                                para amanhã.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="actions" style="margin-top: 16px;">
                            <button class="btn btn-primary btn-block" type="button" disabled="@_busy"
                                    @onclick="() => StartAsync(workout.Id)">
                                <AppIcon Name="play" Size="18" />
                                Iniciar treino
                            </button>
                        </div>
                    }
                }
                else
                {
                    @if (workout.Today.IsRunning)
                    {
                        <div class="timer-card">
                            <span class="timer-icon"><AppIcon Name="timer" Size="22" /></span>
                            <div>
                                <span class="timer-label">Tempo de treino</span>
                                <span class="timer-value">@Clock(workout.Today)</span>
                            </div>
                            <span class="pulse-dot"></span>
                        </div>
                    }
                    else
                    {
                        <div class="summary-strip">
                            <span class="summary-item">
                                <AppIcon Name="timer" Size="15" />
                                @DisplayText.Duration(workout.Today.ElapsedSeconds)
                            </span>
                            <span class="summary-item">
                                <AppIcon Name="dumbbell" Size="15" />
                                @workout.Today.Sets.Count @(workout.Today.Sets.Count == 1 ? "série" : "séries")
                            </span>
                            <span class="summary-item">
                                <AppIcon Name="scale" Size="15" />
                                @DisplayText.Volume(Volume(workout.Today))
                            </span>
                        </div>
                    }

                    <div class="compare-list">
                        @foreach (var row in Compare(workout))
                        {
                            <div class="compare-row @(row.IsCompleted ? "compare-row--done" : "")">
                                <div class="compare-exercise">
                                    @if (workout.Today.IsRunning && row.ExerciseId is { } exerciseId)
                                    {
                                        <label class="exercise-tick" title="Marcar @row.ExerciseName como concluído">
                                            <input type="checkbox"
                                                   aria-label="Concluir @row.ExerciseName"
                                                   @bind="_ticks[(workout.Id, exerciseId)]"
                                                   @bind:after="() => ToggleAsync(workout, exerciseId)" />
                                            <span class="exercise-tick__box">
                                                <AppIcon Name="check" Size="14" />
                                            </span>
                                        </label>
                                    }

                                    <div class="compare-exercise__text">
                                        <strong>@row.ExerciseName</strong>
                                        <small>@row.Prescribed</small>
                                    </div>

                                    @if (row.RestSeconds > 0)
                                    {
                                        <button type="button" class="chip chip--accent rest-chip"
                                                aria-label="@RestLabel(row.ExerciseName, row.RestSeconds)"
                                                @onclick="() => OpenRestTimer(row.ExerciseName, row.RestSeconds)">
                                            ⏱ @(row.RestSeconds)s
                                        </button>
                                    }
                                </div>

                                <div class="set-pills">
                                    @if (row.Performed.Count == 0)
                                    {
                                        <span class="muted" style="font-size: 0.78rem;">Ainda não registrado</span>
                                    }
                                    else
                                    {
                                        @foreach (var performed in row.Performed)
                                        {
                                            <span class="set-pill">@performed</span>
                                        }
                                    }
                                </div>

                                @* The load and the repetitions start on what the personal prescribed: the
                                   athlete only changes them when the real effort was different. *@
                                @if (workout.Today.IsRunning && row.ExerciseId is { } id)
                                {
                                    <div class="set-log">
                                        <label class="set-log__field">
                                            <span>reps</span>
                                            <input id="set-reps-@id" type="number" inputmode="numeric"
                                                   min="1" max="100" step="1" title="Repetições"
                                                   aria-label="Repetições de @row.ExerciseName"
                                                   @bind="_reps[(workout.Id, id)]"
                                                   @bind:event="oninput"
                                                   @bind:culture="CultureInfo.InvariantCulture" />
                                        </label>
                                        <label class="set-log__field">
                                            <span>kg</span>
                                            <input id="set-load-@id" type="number" inputmode="decimal"
                                                   min="0" step="0.5" title="Carga (kg)"
                                                   aria-label="Carga em quilos de @row.ExerciseName"
                                                   @bind="_loads[(workout.Id, id)]"
                                                   @bind:event="oninput"
                                                   @bind:culture="CultureInfo.InvariantCulture" />
                                        </label>
                                        <button class="btn btn-primary btn-sm" type="button" disabled="@_busy"
                                                @onclick="() => LogSetAsync(workout, id)">
                                            <AppIcon Name="plus" Size="16" />
                                            Registrar
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (workout.Today.IsRunning)
                    {
                        <section class="set-logger">
                            <div class="section-head">
                                <h3>Registrar série</h3>
                                <span class="chip">@(workout.Today.Sets.Count + 1)ª do treino</span>
                            </div>

                            <p class="muted" style="margin: 0 0 14px; font-size: 0.8rem;">
                                Marque o <strong>check</strong> de cada exercício que você fez. A carga e as
                                repetições já vêm da prescrição: só mude quando o que você levantou for
                                diferente.
                            </p>

                            <div class="actions">
                                <button class="btn btn-secondary" type="button" disabled="@(_busy || !AllTicked(workout))"
                                        @onclick="() => FinishAsync(workout)">
                                    Finalizar treino
                                </button>
                                <button class="btn btn-danger" type="button" disabled="@_busy"
                                        @onclick="() => CancelAsync(workout)">
                                    Cancelar
                                </button>
                            </div>

                            @if (!AllTicked(workout))
                            {
                                <p class="muted" style="margin: 10px 0 0; font-size: 0.78rem;">
                                    Faltam @Pending(workout) @(Pending(workout) == 1 ? "exercício" : "exercícios")
                                    para marcar antes de finalizar.
                                </p>
                            }
                        </section>

                        <div class="workout-foot">
                            <span>Começou às @workout.Today.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                            <span>@workout.Today.Sets.Count @(workout.Today.Sets.Count == 1 ? "série registrada" : "séries registradas")</span>
                        </div>
                    }
                }
            </article>
        }
    </div>
}

@if (_restSeconds is { } restSeconds)
{
    <RestTimerModal Seconds="restSeconds" ExerciseName="@_restExerciseName" OnClose="CloseRestTimer" />
}

@code {
    private MyWorkoutSeriesResponse? _mine;
    private string? _trainerAvatarUrl;
    private IReadOnlyList<ExerciseResponse> _catalog = [];

    /// <summary>Load the athlete typed for each prescribed exercise, per workout.</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), decimal> _loads = [];

    /// <summary>Repetitions the athlete typed for each prescribed exercise, per workout.</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), int> _reps = [];

    /// <summary>The tick of each prescribed exercise, per workout. The server has the last word.</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), bool> _ticks = [];

    private int? _restSeconds;
    private string _restExerciseName = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private System.Timers.Timer? _ticker;
    private volatile bool _disposed;
    private DateTimeOffset _loadedAt = DateTimeOffset.UtcNow;

    private int TermPercent =>
        _mine is null ? 0 : Math.Clamp((int)Math.Round(_mine.DaysRemaining / 60d * 100), 0, 100);

    /// <summary>Whether the day already has a workout — running or finished.</summary>
    private bool HasWorkoutToday =>
        _mine?.Series.Workouts.Any(workout => workout.Today is not null) == true;

    protected override async Task OnInitializedAsync()
    {
        _ticker = new System.Timers.Timer(1000);
        _ticker.Elapsed += OnTick;
        _ticker.AutoReset = true;
        _ticker.Start();

        await RunAsync(ReloadAsync);
    }

    public void Dispose()
    {
        _disposed = true;
        _ticker?.Dispose();
    }

    /// <summary>
    /// The workout clock. <see cref="System.Timers.Timer"/> fires outside the Blazor dispatcher,
    /// so the tick only schedules a render on the UI context. After <see cref="Dispose"/> the tick is
    /// ignored: without that guard, a tick on its way to the dispatcher would become an unhandled
    /// exception (the handler is <c>async void</c>) and would show up as "erro inesperado" when leaving the screen.
    /// </summary>
    private async void OnTick(object? sender, System.Timers.ElapsedEventArgs args)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page left the scene while this tick was still on its way to the dispatcher.
        }
        catch (InvalidOperationException)
        {
            // The render handle is no longer valid because the component was disposed.
        }
    }

    private void OpenRestTimer(string exerciseName, int seconds)
    {
        _restExerciseName = exerciseName;
        _restSeconds = seconds;
    }

    /// <summary>What the screen reader reads on the chip: the rest prescribed for that exercise.</summary>
    private static string RestLabel(string exerciseName, int seconds) =>
        $"Descanso prescrito de {exerciseName}: {seconds} segundos";

    private void CloseRestTimer()
    {
        _restSeconds = null;
        _restExerciseName = string.Empty;
    }

    private async Task StartAsync(Guid workoutId) =>
        await RunAsync(async () =>
        {
            await Api.StartWorkoutAsync(new StartWorkoutRequest(workoutId));
            await ReloadAsync();
        });

    private async Task LogSetAsync(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        await RunAsync(async () =>
        {
            await Api.LogPerformedSetAsync(
                workout.Today!.WorkoutSessionId,
                new LogPerformedSetRequest(
                    exerciseId,
                    _loads[(workout.Id, exerciseId)],
                    _reps[(workout.Id, exerciseId)]));

            await ReloadAsync();
        });

    /// <summary>
    /// Ticks (or unticks) one exercise of the workout in progress. The screen shows the tick right
    /// away; the server has the last word, so the sheet is read again when the request ends.
    /// </summary>
    private async Task ToggleAsync(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        await RunAsync(async () =>
        {
            await Api.SetExerciseCompletionAsync(
                workout.Today!.WorkoutSessionId,
                exerciseId,
                _ticks[(workout.Id, exerciseId)]);

            await ReloadAsync();
        });

    private async Task FinishAsync(WorkoutSeriesWorkoutResponse workout) =>
        await RunAsync(async () =>
        {
            await Api.FinishWorkoutAsync(workout.Today!.WorkoutSessionId);
            await ReloadAsync();
        });

    private async Task CancelAsync(WorkoutSeriesWorkoutResponse workout) =>
        await RunAsync(async () =>
        {
            await Api.CancelWorkoutAsync(workout.Today!.WorkoutSessionId);
            await ReloadAsync();
        });

    /// <summary>
    /// Runs an action against the server. The error goes to the toast in the corner and the sheet is
    /// read again, so the screen never keeps a state the server refused.
    /// </summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));

            await ReloadQuietlyAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads the sheet again after a refusal. A second failure is swallowed: the first toast already
    /// said what happened, and an error escaping here would take the screen down with it.
    /// </summary>
    private async Task ReloadQuietlyAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (ApiException)
        {
            // The sheet stays as it was; the toast carries the reason.
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _catalog = await Api.GetExercisesAsync();
            _mine = await Api.GetMyWorkoutSeriesAsync();
            if (_mine is null)
            {
                _trainerAvatarUrl = null;
            }
            else
            {
                try
                {
                    _trainerAvatarUrl = await Api.GetUserAvatarAsync(_mine.Series.TrainerId);
                }
                catch
                {
                    _trainerAvatarUrl = null;
                }
            }
            _loadedAt = DateTimeOffset.UtcNow;

            var workouts = _mine?.Series.Workouts ?? Enumerable.Empty<WorkoutSeriesWorkoutResponse>();

            foreach (var workout in workouts)
            {
                var completed = workout.Today?.CompletedExerciseIds ?? [];

                foreach (var prescribed in workout.Exercises)
                {
                    // Starts at the load and the repetitions the personal trainer prescribed; whatever
                    // the athlete already typed stands.
                    _loads.TryAdd((workout.Id, prescribed.ExerciseId), LoadValue(prescribed.LoadKilograms));
                    _reps.TryAdd((workout.Id, prescribed.ExerciseId), prescribed.Repetitions);

                    // The tick comes from the server: it is the truth about the workout.
                    _ticks[(workout.Id, prescribed.ExerciseId)] = completed.Contains(prescribed.ExerciseId);
                }
            }
        }
        finally
        {
            // The sheet is ready (or gave up): the screen stops waiting either way.
            _loading = false;
        }
    }

    /// <summary>
    /// The prescription next to what the athlete actually did: one row per prescribed exercise — the only
    /// ones he can log — plus the exercises that left the prescription after being logged, shown as a
    /// record (the trainer may edit the series while a workout is open).
    /// </summary>
    private IReadOnlyList<ComparisonRow> Compare(WorkoutSeriesWorkoutResponse workout)
    {
        var today = workout.Today!;

        var rows = workout.Exercises
            .Select(prescribed => new ComparisonRow(
                prescribed.ExerciseId,
                prescribed.ExerciseName,
                Prescribed(prescribed),
                Performed(today.Sets.Where(set => set.ExerciseId == prescribed.ExerciseId)),
                prescribed.RestSeconds,
                today.CompletedExerciseIds.Contains(prescribed.ExerciseId)))
            .ToList();

        var extras = today.Sets
            .Where(set => workout.Exercises.All(prescribed => prescribed.ExerciseId != set.ExerciseId))
            .Select(set => set.ExerciseId)
            .Distinct();

        rows.AddRange(extras.Select(exerciseId => new ComparisonRow(
            null,
            ExerciseName(exerciseId),
            "—",
            Performed(today.Sets.Where(set => set.ExerciseId == exerciseId)),
            0,
            today.CompletedExerciseIds.Contains(exerciseId))));

        return rows;
    }

    /// <summary>Whether every prescribed exercise of the workout is ticked.</summary>
    private static bool AllTicked(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises.All(prescribed =>
            workout.Today!.CompletedExerciseIds.Contains(prescribed.ExerciseId));

    /// <summary>How many prescribed exercises are still waiting for their tick.</summary>
    private static int Pending(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises.Count(prescribed =>
            !workout.Today!.CompletedExerciseIds.Contains(prescribed.ExerciseId));

    private static string Prescribed(PrescribedExerciseResponse prescribed) =>
        $"{prescribed.Sets} × {prescribed.Repetitions} @ {Load(prescribed.LoadKilograms)}";

    private static string Load(decimal? kilograms) =>
        kilograms is { } load ? $"{load:0.##} kg" : "peso corporal";

    /// <summary>
    /// The load the field starts with, without the zeros the scale of the database leaves behind:
    /// eighty kilos are eighty, not eighty point zero zero.
    /// </summary>
    private static decimal LoadValue(decimal? kilograms) =>
        kilograms is { } load
            ? decimal.Parse(load.ToString("0.####", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture)
            : 0m;

    /// <summary>How the performed set reads: the repetitions and the load, as the sheet shows it.</summary>
    private static IReadOnlyList<string> Performed(IEnumerable<PerformedSetResponse> sets) =>
        [.. sets.Select(set => set.LoadKilograms > 0m
            ? $"{set.Repetitions}x {set.LoadKilograms:0.##}kg"
            : $"{set.Repetitions}x peso corporal")];

    private static decimal Volume(TodayWorkoutResponse today) =>
        today.Sets.Sum(set => set.LoadKilograms * set.Repetitions);

    private string ExerciseName(Guid exerciseId) =>
        _catalog.FirstOrDefault(exercise => exercise.Id == exerciseId)?.Name ?? exerciseId.ToString();

    /// <summary>
    /// The running clock. It counts from the seconds the server measured and adds only the time that
    /// passed on this page, so a skewed browser clock cannot invent a duration.
    /// </summary>
    private string Clock(TodayWorkoutResponse today) =>
        DisplayText.Duration(today.ElapsedSeconds + (int)(DateTimeOffset.UtcNow - _loadedAt).TotalSeconds);

    private sealed record ComparisonRow(
        Guid? ExerciseId,
        string ExerciseName,
        string Prescribed,
        IReadOnlyList<string> Performed,
        int RestSeconds,
        bool IsCompleted);
}
