@page "/today"
@attribute [Authorize]
@implements IDisposable
@inject FitTrackApiClient Api
@inject ToastService Toasts

<PageTitle>Hoje — FitTrack</PageTitle>

<PageHeader Eyebrow="@DisplayText.Today"
            Title="Hoje"
            Subtitle="Escolha o treino do dia e registre cada série." />

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando seu treino…</span>
    </div>
}
else if (_mine is null)
{
    <div class="empty-state">
        <AppIcon Name="layers" Size="28" />
        <h2>Nenhuma série vinculada</h2>
        <p>Seu personal ainda não vinculou uma série. Fale com ele para receber os treinos.</p>
    </div>
}
else if (_mine.Series.Workouts.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="calendar" Size="28" />
        <h2>Série sem treinos</h2>
        <p>A série <strong>@_mine.Series.Name</strong> ainda não tem treinos montados.</p>
    </div>
}
else
{
    <section class="series-banner">
        <div class="series-banner-main">
            <span class="chip @(_mine.IsExpired ? "chip--danger" : "chip--accent")">
                @(_mine.IsExpired ? "Série vencida" : "Série ativa")
            </span>
            <h2>@_mine.Series.Name</h2>
            @if (_mine.IsSelfAuthored)
            {
                <p class="trainer-line">
                    <AppIcon Name="user" Size="16" />
                    Montado por você
                </p>
            }
            else
            {
                <p class="trainer-line">
                    <UserAvatar AvatarUrl="@_trainerAvatarUrl" NameOrEmail="@_mine.TrainerName" Size="24" />
                    Personal <strong>@_mine.TrainerName</strong> ·
                    @_mine.Series.Workouts.Count @(_mine.Series.Workouts.Count == 1 ? "treino disponível" : "treinos disponíveis")
                </p>
            }
        </div>

        <div class="series-term">
            <div class="series-term-head">
                <span>@(_mine.IsExpired ? "Vencida" : "Validade")</span>
                <strong>@TermPercent%</strong>
            </div>
            <div class="progress">
                <span style="width: @TermPercent%"></span>
            </div>
            @if (!_mine.IsExpired)
            {
                <p class="muted" style="margin-top: 7px; font-size: 0.74rem;">
                    @_mine.DaysRemaining @(_mine.DaysRemaining == 1 ? "dia restante" : "dias restantes")
                </p>
            }
        </div>
    </section>

    <div class="workout-list">
        @foreach (var workout in _mine.Series.Workouts)
        {
            <article class="card workout-card" @key="workout.Id">
                <div class="workout-head">
                    <span class="label-badge">@workout.Label</span>

                    <div class="workout-title">
                        <h2>@workout.Name</h2>
                        <p class="muted">@workout.Exercises.Count @(workout.Exercises.Count == 1 ? "exercício" : "exercícios")</p>
                    </div>

                    @if (workout.Today is null)
                    {
                        <span class="chip">A fazer</span>
                    }
                    else if (workout.Today.IsRunning)
                    {
                        <span class="chip chip--accent">
                            Em andamento
                            <span class="pulse-dot"></span>
                        </span>
                    }
                    else
                    {
                        <span class="chip chip--success">Concluído</span>
                    }
                </div>

                @if (workout.Today is null)
                {
                    <SeriesExerciseList Exercises="workout.Exercises"
                                        Expanded="@IsExpanded(workout)"
                                        ExpandedChanged="@(value => SetExpanded(workout, value))"
                                        RestTimerRequested="@(prescribed => OpenRestTimer(prescribed.ExerciseName, prescribed.RestSeconds))" />

                    @if (_mine.IsExpired)
                    {
                        <div class="alert alert--error" style="margin: 16px 0 0;">
                            <AppIcon Name="info" Size="18" />
                            <span>
                                A série venceu, então não dá para começar um treino novo. Um treino já
                                iniciado ainda pode ser finalizado.
                            </span>
                        </div>
                    }
                    else if (HasWorkoutToday)
                    {
                        <div class="alert alert--info" style="margin: 16px 0 0;">
                            <AppIcon Name="info" Size="18" />
                            <span>
                                Você já treinou hoje. Só dá para fazer um treino por dia — o próximo fica
                                para amanhã.
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="actions" style="margin-top: 16px;">
                            <button class="btn btn-primary btn-block" type="button" disabled="@_busy"
                                    @onclick="() => StartAsync(workout.Id)">
                                <AppIcon Name="play" Size="18" />
                                Iniciar treino
                            </button>
                        </div>
                    }
                }
                else
                {
                    @if (workout.Today.IsRunning)
                    {
                        <div class="timer-card">
                            <span class="timer-icon"><AppIcon Name="timer" Size="22" /></span>
                            <div>
                                <span class="timer-label">Tempo de treino</span>
                                <span class="timer-value">@Clock(workout.Today)</span>
                            </div>
                            <span class="pulse-dot"></span>
                        </div>
                    }
                    else
                    {
                        <div class="summary-strip">
                            <span class="summary-item">
                                <AppIcon Name="timer" Size="15" />
                                @DisplayText.Duration(workout.Today.ElapsedSeconds)
                            </span>
                            <span class="summary-item">
                                <AppIcon Name="dumbbell" Size="15" />
                                @workout.Today.Sets.Count @(workout.Today.Sets.Count == 1 ? "série" : "séries")
                            </span>
                            <span class="summary-item">
                                <AppIcon Name="scale" Size="15" />
                                @DisplayText.Volume(Volume(workout.Today))
                            </span>
                            @if (!string.IsNullOrWhiteSpace(workout.Today.Intensity))
                            {
                                <span class="summary-item">
                                    <AppIcon Name="sparkles" Size="15" />
                                    @DisplayText.IntensityLabel(workout.Today.Intensity)
                                </span>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(workout.Today.Notes))
                    {
                        <p class="muted" style="margin: 14px 0 0; font-size: 0.82rem;">
                            <strong>Sobre o treino:</strong> @workout.Today.Notes
                        </p>
                    }

                    <div class="compare-list">
                        @foreach (var row in Compare(workout))
                        {
                            <div class="compare-row @(row.IsCompleted ? "compare-row--done" : "")">
                                <div class="compare-exercise">
                                    @if (workout.Today.IsRunning && row.ExerciseId is { } exerciseId)
                                    {
                                        <label class="exercise-tick" title="Marcar @row.ExerciseName como concluído">
                                            <input type="checkbox"
                                                   aria-label="Concluir @row.ExerciseName"
                                                   checked="@IsTicked(workout, exerciseId)"
                                                   @onchange="() => Toggle(workout, exerciseId)" />
                                            <span class="exercise-tick__box">
                                                <AppIcon Name="check" Size="14" />
                                            </span>
                                        </label>
                                    }

                                    <div class="compare-exercise__text">
                                        <strong>@row.ExerciseName</strong>
                                        @if (workout.Today.IsRunning && row.ExerciseId is { } editable)
                                        {
                                            <button type="button" class="effort-link"
                                                    aria-label="Ajustar @row.ExerciseName"
                                                    @onclick="() => StartEditing(workout, editable)">
                                                @Effort(workout, row)
                                            </button>
                                        }
                                        else
                                        {
                                            <small>@Effort(workout, row)</small>
                                        }
                                    </div>

                                    @if (row.RestSeconds > 0)
                                    {
                                        <button type="button" class="chip chip--accent rest-chip"
                                                aria-label="@RestLabel(row.ExerciseName, row.RestSeconds)"
                                                @onclick="() => OpenRestTimer(row.ExerciseName, row.RestSeconds)">
                                            ⏱ @(row.RestSeconds)s
                                        </button>
                                    }
                                </div>

                                <div class="set-pills">
                                    @if (row.Performed.Count == 0)
                                    {
                                        @if (!workout.Today.IsRunning)
                                        {
                                            <span class="muted" style="font-size: 0.78rem;">Ainda não registrado</span>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var performed in row.Performed)
                                        {
                                            <span class="set-pill">@performed</span>
                                        }
                                    }
                                </div>

                                @* The load and the repetitions stay with what the personal prescribed: the
                                   athlete opens the fields when the real effort was different. *@
                                @if (workout.Today.IsRunning && row.ExerciseId is { } id && IsEditing(workout, id))
                                {
                                    <div class="set-log set-log--series">
                                        <div class="set-log__units" role="group" aria-label="Unidade de carga de @row.ExerciseName">
                                            <button type="button" class="unit-toggle @(IsBarra(workout, id) ? "" : "unit-toggle--active")"
                                                    @onclick='() => SetLoadUnit(workout, id, "kg")'>
                                                kg
                                            </button>
                                            <button type="button" class="unit-toggle @(IsBarra(workout, id) ? "unit-toggle--active" : "")"
                                                    @onclick='() => SetLoadUnit(workout, id, "barra")'>
                                                barra
                                            </button>
                                        </div>
                                        @for (var setIndex = 0; setIndex < row.Sets; setIndex++)
                                        {
                                            <div class="set-log__series-row">
                                                <span class="muted">Série @(setIndex + 1)</span>
                                                <label class="set-log__field">
                                                    <span>reps</span>
                                                    <input id="set-reps-@id-@setIndex" type="number" inputmode="numeric"
                                                           min="1" max="100" step="1" title="Repetições"
                                                           aria-label="Repetições da série @(setIndex + 1) de @row.ExerciseName"
                                                           @bind="_setReps[(workout.Id, id)][setIndex]"
                                                           @bind:event="oninput"
                                                           @bind:culture="CultureInfo.InvariantCulture" />
                                                </label>
                                                <label class="set-log__field">
                                                    <span>@(IsBarra(workout, id) ? "barras" : "kg")</span>
                                                    <input id="set-load-@id-@setIndex" type="number" inputmode="decimal"
                                                           min="0" step="any" title="Carga"
                                                           aria-label="Carga da série @(setIndex + 1) de @row.ExerciseName"
                                                           @bind:get="SetLoadDisplay(workout, id, setIndex)"
                                                           @bind:set="(decimal value) => SetSetLoadInput(workout, id, setIndex, value)"
                                                           @bind:event="oninput"
                                                           @bind:culture="CultureInfo.InvariantCulture" />
                                                </label>
                                            </div>
                                        }
                                        @if (_exerciseHistory.TryGetValue(id, out var history) && history.Count > 0)
                                        {
                                            <div class="exercise-history">
                                                <span class="muted">
                                                    Último: @Load(history[0].Sets.Where(s => s.ExerciseId == id).Select(s => s.LoadKilograms).FirstOrDefault()) (@history[0].WorkoutDate.ToString("dd/MM"))
                                                </span>
                                                <details>
                                                    <summary>Histórico deste exercício</summary>
                                                    <ul>
                                                        @foreach (var session in history)
                                                        {
                                                            var sets = session.Sets.Where(s => s.ExerciseId == id).ToList();
                                                            <li>@session.WorkoutDate.ToString("dd/MM") · @string.Join(" · ", sets.Select(s => $"{s.Repetitions}×{s.LoadKilograms:0.##}kg"))</li>
                                                        }
                                                    </ul>
                                                </details>
                                            </div>
                                        }
                                        else if (_historyLoading.Contains(id))
                                        {
                                            <span class="muted" style="font-size:0.78rem;">Carregando histórico…</span>
                                        }

                                        <button class="btn btn-primary btn-sm" type="button"
                                                @onclick="() => StopEditing(workout, id)">
                                            <AppIcon Name="check" Size="16" />
                                            Pronto
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (workout.Today.IsRunning)
                    {
                        <section class="set-logger">
                            <div class="section-head">
                                <h3>Finalizar o treino</h3>
                                <span class="chip">@PlannedSets(workout) @(PlannedSets(workout) == 1 ? "série prevista" : "séries previstas")</span>
                            </div>

                            <p class="muted" style="margin: 0 0 14px; font-size: 0.8rem;">
                                Marque o <strong>check</strong> de cada exercício que você fez. A carga e as
                                repetições já vêm da prescrição: só mude quando o que você levantou for
                                diferente. Tudo é enviado quando você finaliza o treino.
                            </p>

                            <div class="actions">
                                <button class="btn btn-secondary" type="button" disabled="@(_busy || !AllTicked(workout))"
                                        @onclick="() => OpenFinishModal(workout)">
                                    Finalizar treino
                                </button>
                                <button class="btn btn-danger" type="button" disabled="@_busy"
                                        @onclick="() => CancelAsync(workout)">
                                    Cancelar
                                </button>
                            </div>

                            @if (!AllTicked(workout))
                            {
                                <p class="muted" style="margin: 10px 0 0; font-size: 0.78rem;">
                                    Faltam @Pending(workout) @(Pending(workout) == 1 ? "exercício" : "exercícios")
                                    para marcar antes de finalizar.
                                </p>
                            }
                        </section>

                        <div class="workout-foot">
                            <span>Começou às @workout.Today.StartedAt.ToLocalTime().ToString("HH:mm")</span>
                            <span>@MarkedSets(workout) @(MarkedSets(workout) == 1 ? "série marcada" : "séries marcadas")</span>
                        </div>
                    }
                }
            </article>
        }
    </div>
}

@if (_restSeconds is { } restSeconds)
{
    <RestTimerModal Seconds="restSeconds" ExerciseName="@_restExerciseName" OnClose="CloseRestTimer" />
}

@if (_finishing)
{
    <FinishWorkoutModal Busy="_busy"
                         @bind-Intensity="_finishIntensity"
                         @bind-Notes="_finishNotes"
                         OnConfirm="ConfirmFinishAsync"
                         OnCancel="CloseFinishModal" />
}

@code {
    private MyWorkoutSeriesResponse? _mine;
    private string? _trainerAvatarUrl;
    private IReadOnlyList<ExerciseResponse> _catalog = [];

    /// <summary>Repetitions the athlete typed for each prescribed set, per workout/exercise.</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), List<int>> _setReps = [];

    /// <summary>Load (in kg) the athlete typed for each prescribed set, per workout/exercise.</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), List<decimal>> _setLoads = [];

    /// <summary>Unit chosen for the load input of each prescribed exercise (kg or barra).</summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), string> _loadUnits = [];

    private const decimal BarWeightKilograms = 20m;

    /// <summary>
    /// The tick of each prescribed exercise, per workout. While the workout runs the screen owns it:
    /// the server only learns the marks when the athlete finishes, so nothing here costs a request.
    /// </summary>
    private readonly Dictionary<(Guid WorkoutId, Guid ExerciseId), bool> _ticks = [];

    /// <summary>
    /// The session the local ticks belong to, per workout. A new session starts a new sheet of marks,
    /// and the marks of the previous one never leak into it.
    /// </summary>
    private readonly Dictionary<Guid, Guid> _tickSession = [];

    /// <summary>The exercises whose values the athlete is adjusting right now.</summary>
    private readonly HashSet<(Guid WorkoutId, Guid ExerciseId)> _editing = [];

    /// <summary>Recent finished sessions containing a given exercise, for the history panel.</summary>
    private readonly Dictionary<Guid, List<WorkoutSessionResponse>> _exerciseHistory = [];

    private readonly HashSet<Guid> _historyLoading = [];

    /// <summary>
    /// The workouts whose prescribed exercises are open on the sheet. The list starts collapsed —
    /// a full series is up to five cards, and the athlete opens the one they mean to do.
    /// </summary>
    private readonly HashSet<Guid> _expanded = [];

    private int? _restSeconds;
    private string _restExerciseName = string.Empty;
    private bool _finishing;
    private Guid? _finishingWorkoutId;
    private string _finishIntensity = string.Empty;
    private string _finishNotes = string.Empty;
    private bool _loading = true;
    private bool _busy;
    private System.Timers.Timer? _ticker;
    private volatile bool _disposed;
    private DateTimeOffset _loadedAt = DateTimeOffset.UtcNow;

    private int TermPercent =>
        _mine is null ? 0 : Math.Clamp((int)Math.Round(_mine.DaysRemaining / 60d * 100), 0, 100);

    /// <summary>Whether the day already has a workout — running or finished.</summary>
    private bool HasWorkoutToday =>
        _mine?.Series.Workouts.Any(workout => workout.Today is not null) == true;

    protected override async Task OnInitializedAsync()
    {
        _ticker = new System.Timers.Timer(1000);
        _ticker.Elapsed += OnTick;
        _ticker.AutoReset = true;
        _ticker.Start();

        await RunAsync(ReloadAsync);
    }

    public void Dispose()
    {
        _disposed = true;
        _ticker?.Dispose();
    }

    /// <summary>
    /// The workout clock. <see cref="System.Timers.Timer"/> fires outside the Blazor dispatcher,
    /// so the tick only schedules a render on the UI context. After <see cref="Dispose"/> the tick is
    /// ignored: without that guard, a tick on its way to the dispatcher would become an unhandled
    /// exception (the handler is <c>async void</c>) and would show up as "erro inesperado" when leaving the screen.
    /// </summary>
    private async void OnTick(object? sender, System.Timers.ElapsedEventArgs args)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!_disposed)
                {
                    StateHasChanged();
                }
            });
        }
        catch (ObjectDisposedException)
        {
            // The page left the scene while this tick was still on its way to the dispatcher.
        }
        catch (InvalidOperationException)
        {
            // The render handle is no longer valid because the component was disposed.
        }
    }

    private void OpenRestTimer(string exerciseName, int seconds)
    {
        _restExerciseName = exerciseName;
        _restSeconds = seconds;
    }

    /// <summary>What the screen reader reads on the chip: the rest prescribed for that exercise.</summary>
    private static string RestLabel(string exerciseName, int seconds) =>
        $"Descanso prescrito de {exerciseName}: {seconds} segundos";

    private void CloseRestTimer()
    {
        _restSeconds = null;
        _restExerciseName = string.Empty;
    }

    private async Task StartAsync(Guid workoutId) =>
        await RunAsync(async () =>
        {
            await Api.StartWorkoutAsync(new StartWorkoutRequest(workoutId));
            await ReloadAsync();
        });

    /// <summary>
    /// Ticks (or unticks) one exercise of the workout in progress. The screen owns the mark: the
    /// server only learns it when the athlete finishes, so nothing leaves the browser here.
    /// </summary>
    private void Toggle(WorkoutSeriesWorkoutResponse workout, Guid exerciseId)
    {
        _ticks[(workout.Id, exerciseId)] = !_ticks.GetValueOrDefault((workout.Id, exerciseId));
    }

    /// <summary>Whether the athlete marked the exercise as done.</summary>
    private bool IsTicked(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        _ticks.GetValueOrDefault((workout.Id, exerciseId));

    private bool IsEditing(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        _editing.Contains((workout.Id, exerciseId));

    private void StartEditing(WorkoutSeriesWorkoutResponse workout, Guid exerciseId)
    {
        _editing.Add((workout.Id, exerciseId));
        _ = LoadExerciseHistoryAsync(exerciseId);
    }

    private async Task LoadExerciseHistoryAsync(Guid exerciseId)
    {
        if (_exerciseHistory.ContainsKey(exerciseId) || _historyLoading.Contains(exerciseId))
        {
            return;
        }

        _historyLoading.Add(exerciseId);
        try
        {
            var sessions = await Api.GetSessionsAsync();
            var filtered = sessions
                .Where(session => !session.IsRunning && session.Sets.Any(set => set.ExerciseId == exerciseId))
                .OrderByDescending(session => session.WorkoutDate)
                .Take(5)
                .ToList();
            _exerciseHistory[exerciseId] = filtered;
        }
        catch (ApiException)
        {
            _exerciseHistory[exerciseId] = [];
        }
        finally
        {
            _historyLoading.Remove(exerciseId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopEditing(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        _editing.Remove((workout.Id, exerciseId));

    /// <summary>Whether the prescribed list of the workout is open. The default for all is collapsed.</summary>
    private bool IsExpanded(WorkoutSeriesWorkoutResponse workout) =>
        _expanded.Contains(workout.Id);

    private void SetExpanded(WorkoutSeriesWorkoutResponse workout, bool expanded)
    {
        if (expanded)
        {
            _expanded.Add(workout.Id);
        }
        else
        {
            _expanded.Remove(workout.Id);
        }
    }

    /// <summary>
    /// Opens the closing modal. The workout stays as it is until the athlete confirms: cancelling
    /// the modal sends nothing.
    /// </summary>
    private void OpenFinishModal(WorkoutSeriesWorkoutResponse workout)
    {
        _finishing = true;
        _finishIntensity = string.Empty;
        _finishNotes = string.Empty;
        _finishingWorkoutId = workout.Id;
    }

    private void CloseFinishModal()
    {
        _finishing = false;
        _finishIntensity = string.Empty;
        _finishNotes = string.Empty;
        _finishingWorkoutId = null;
    }

    /// <summary>
    /// Closes the workout: the exercises the athlete marked, with the repetitions and the load they
    /// really used, the level they gave the session and what they wrote about it — all in one
    /// request. The modal only closes when the server accepts.
    /// </summary>
    private async Task ConfirmFinishAsync()
    {
        var workout = _mine?.Series.Workouts.FirstOrDefault(candidate =>
            candidate.Id == _finishingWorkoutId && candidate.Today is { IsRunning: true });

        if (workout is null)
        {
            CloseFinishModal();
            return;
        }

        _busy = true;

        try
        {
            await Api.FinishWorkoutAsync(
                workout.Today!.WorkoutSessionId,
                new FinishWorkoutRequest(_finishIntensity, _finishNotes, Payload(workout)));

            CloseFinishModal();

            await ReloadAsync();
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));

            // The screen is read again, but the marks of the athlete stay: they belong to the
            // session, not to what the server knows about it.
            await ReloadQuietlyAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// What the athlete did, as the server will record it: one entry per marked exercise of the
    /// current prescription, with the repetitions and the load they used.
    /// </summary>
    private IReadOnlyList<PerformedExerciseRequest> Payload(WorkoutSeriesWorkoutResponse workout) =>
        [.. workout.Exercises
            .Where(prescribed => IsTicked(workout, prescribed.ExerciseId))
            .Select(prescribed =>
            {
                var key = (workout.Id, prescribed.ExerciseId);
                var reps = _setReps.TryGetValue(key, out var rl)
                    ? rl
                    : Enumerable.Repeat(prescribed.Repetitions, prescribed.Sets).ToList();
                var loads = _setLoads.TryGetValue(key, out var ll)
                    ? ll
                    : Enumerable.Repeat(LoadValue(prescribed.LoadKilograms), prescribed.Sets).ToList();

                var sets = Enumerable.Range(0, prescribed.Sets).Select(i => new PerformedSetRequest(
                    i < reps.Count ? reps[i] : prescribed.Repetitions,
                    i < loads.Count ? loads[i] : LoadValue(prescribed.LoadKilograms))).ToList();

                return new PerformedExerciseRequest(prescribed.ExerciseId, sets);
            })];

    private async Task CancelAsync(WorkoutSeriesWorkoutResponse workout) =>
        await RunAsync(async () =>
        {
            await Api.CancelWorkoutAsync(workout.Today!.WorkoutSessionId);
            await ReloadAsync();
        });

    /// <summary>
    /// Runs an action against the server. The error goes to the toast in the corner and the sheet is
    /// read again, so the screen never keeps a state the server refused.
    /// </summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));

            await ReloadQuietlyAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Reads the sheet again after a refusal. A second failure is swallowed: the first toast already
    /// said what happened, and an error escaping here would take the screen down with it.
    /// </summary>
    private async Task ReloadQuietlyAsync()
    {
        try
        {
            await ReloadAsync();
        }
        catch (ApiException)
        {
            // The sheet stays as it was; the toast carries the reason.
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _catalog = await Api.GetExercisesAsync();
            _mine = await Api.GetMyWorkoutSeriesAsync();
            if (_mine is null)
            {
                _trainerAvatarUrl = null;
            }
            else
            {
                try
                {
                    // The athlete who built their own plan has no personal trainer to show.
                    _trainerAvatarUrl = _mine.IsSelfAuthored
                        ? null
                        : await Api.GetUserAvatarAsync(_mine.Series.TrainerId);
                }
                catch
                {
                    _trainerAvatarUrl = null;
                }
            }
            _loadedAt = DateTimeOffset.UtcNow;

            var workouts = _mine?.Series.Workouts ?? Enumerable.Empty<WorkoutSeriesWorkoutResponse>();

            foreach (var workout in workouts)
            {
                foreach (var prescribed in workout.Exercises)
                {
                    // Starts at the load and the repetitions the personal trainer prescribed; whatever
                    // the athlete already typed stands.
                    var key = (workout.Id, prescribed.ExerciseId);
                    if (!_setReps.ContainsKey(key))
                    {
                        _setReps[key] = Enumerable.Repeat(prescribed.Repetitions, prescribed.Sets).ToList();
                        _setLoads[key] = Enumerable.Repeat(LoadValue(prescribed.LoadKilograms), prescribed.Sets).ToList();
                    }
                }

                SyncTicks(workout);
            }
        }
        finally
        {
            // The sheet is ready (or gave up): the screen stops waiting either way.
            _loading = false;
        }
    }

    /// <summary>
    /// Keeps the marks of the athlete in step with the session they belong to. A running workout
    /// keeps the marks of the screen — the server only learns them when the athlete finishes — and a
    /// finished one shows what the server recorded.
    /// </summary>
    private void SyncTicks(WorkoutSeriesWorkoutResponse workout)
    {
        var today = workout.Today;

        if (today is null)
        {
            return;
        }

        // A new session starts a new sheet of marks: the previous one never leaks into it.
        if (!_tickSession.TryGetValue(workout.Id, out var sessionId) || sessionId != today.WorkoutSessionId)
        {
            _tickSession[workout.Id] = today.WorkoutSessionId;

            foreach (var prescribed in workout.Exercises)
            {
                var resetKey = (workout.Id, prescribed.ExerciseId);
                _ticks.Remove(resetKey);
                _setReps[resetKey] = Enumerable.Repeat(prescribed.Repetitions, prescribed.Sets).ToList();
                _setLoads[resetKey] = Enumerable.Repeat(LoadValue(prescribed.LoadKilograms), prescribed.Sets).ToList();
                _loadUnits.Remove(resetKey);
            }
        }

        if (today.IsRunning)
        {
            return;
        }

        foreach (var prescribed in workout.Exercises)
        {
            _ticks[(workout.Id, prescribed.ExerciseId)] = today.CompletedExerciseIds.Contains(prescribed.ExerciseId);
        }
    }

    /// <summary>
    /// The prescription next to what the athlete actually did: one row per prescribed exercise — the only
    /// ones he can log — plus the exercises that left the prescription after being logged, shown as a
    /// record (the trainer may edit the series while a workout is open).
    /// </summary>
    private IReadOnlyList<ComparisonRow> Compare(WorkoutSeriesWorkoutResponse workout)
    {
        var today = workout.Today!;

        var rows = workout.Exercises
            .Select(prescribed => new ComparisonRow(
                prescribed.ExerciseId,
                prescribed.ExerciseName,
                prescribed.Sets,
                prescribed.Repetitions,
                prescribed.LoadKilograms,
                Performed(today.Sets.Where(set => set.ExerciseId == prescribed.ExerciseId)),
                prescribed.RestSeconds,
                IsTicked(workout, prescribed.ExerciseId)))
            .ToList();

        var extras = today.Sets
            .Where(set => workout.Exercises.All(prescribed => prescribed.ExerciseId != set.ExerciseId))
            .Select(set => set.ExerciseId)
            .Distinct();

        rows.AddRange(extras.Select(exerciseId => new ComparisonRow(
            null,
            ExerciseName(exerciseId),
            1,
            0,
            null,
            Performed(today.Sets.Where(set => set.ExerciseId == exerciseId)),
            0,
            today.CompletedExerciseIds.Contains(exerciseId))));

        return rows;
    }

    /// <summary>
    /// The effort of the exercise as the screen shows it: the sets of the prescription with the
    /// repetitions and the load the athlete used. An exercise without load stays "peso corporal".
    /// </summary>
    private string Effort(WorkoutSeriesWorkoutResponse workout, ComparisonRow row)
    {
        if (row.ExerciseId is not { } exerciseId)
        {
            return "—";
        }

        var key = (workout.Id, exerciseId);
        var reps = _setReps.TryGetValue(key, out var rl) ? rl : Enumerable.Repeat(row.Repetitions, row.Sets).ToList();
        var loads = _setLoads.TryGetValue(key, out var ll) ? ll : Enumerable.Repeat(LoadValue(row.PrescribedLoad), row.Sets).ToList();

        // Se todas as séries são iguais, mostra a forma compacta; senão, lista série a série.
        if (reps.Distinct().Count() == 1 && loads.Distinct().Count() == 1)
        {
            return $"{row.Sets} × {reps[0]} @ {(row.PrescribedLoad is null ? "peso corporal" : Load(loads[0]))}";
        }

        return string.Join(" · ", Enumerable.Range(0, row.Sets).Select(i =>
            $"{i + 1}×{reps[i]} @ {(row.PrescribedLoad is null ? "peso corporal" : Load(loads[i]))}"));
    }

    /// <summary>Whether every prescribed exercise of the workout is ticked.</summary>
    private bool AllTicked(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises.All(prescribed => IsTicked(workout, prescribed.ExerciseId));

    /// <summary>How many prescribed exercises are still waiting for their tick.</summary>
    private int Pending(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises.Count(prescribed => !IsTicked(workout, prescribed.ExerciseId));

    /// <summary>How many sets the prescription of the workout has in total.</summary>
    private static int PlannedSets(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises.Sum(prescribed => prescribed.Sets);

    /// <summary>How many sets the athlete has marked so far.</summary>
    private int MarkedSets(WorkoutSeriesWorkoutResponse workout) =>
        workout.Exercises
            .Where(prescribed => IsTicked(workout, prescribed.ExerciseId))
            .Sum(prescribed => prescribed.Sets);

    private bool IsBarra(WorkoutSeriesWorkoutResponse workout, Guid exerciseId) =>
        _loadUnits.GetValueOrDefault((workout.Id, exerciseId)) == "barra";

    private void SetLoadUnit(WorkoutSeriesWorkoutResponse workout, Guid exerciseId, string unit)
    {
        _loadUnits[(workout.Id, exerciseId)] = unit;
    }

    private decimal SetLoadDisplay(WorkoutSeriesWorkoutResponse workout, Guid exerciseId, int setIndex)
    {
        var key = (workout.Id, exerciseId);
        var kilograms = (_setLoads.TryGetValue(key, out var loads) && setIndex < loads.Count)
            ? loads[setIndex]
            : 0m;
        return IsBarra(workout, exerciseId) ? kilograms / BarWeightKilograms : kilograms;
    }

    private void SetSetLoadInput(WorkoutSeriesWorkoutResponse workout, Guid exerciseId, int setIndex, decimal value)
    {
        var key = (workout.Id, exerciseId);
        if (!_setLoads.TryGetValue(key, out var loads))
        {
            return;
        }
        if (setIndex >= loads.Count)
        {
            return;
        }
        loads[setIndex] = IsBarra(workout, exerciseId) ? value * BarWeightKilograms : value;
    }

    private static string Load(decimal? kilograms) =>
        kilograms is { } load ? $"{load:0.##} kg" : "peso corporal";

    /// <summary>
    /// The load the field starts with, without the zeros the scale of the database leaves behind:
    /// eighty kilos are eighty, not eighty point zero zero.
    /// </summary>
    private static decimal LoadValue(decimal? kilograms) =>
        kilograms is { } load
            ? decimal.Parse(load.ToString("0.####", CultureInfo.InvariantCulture), CultureInfo.InvariantCulture)
            : 0m;

    /// <summary>How the performed set reads: the repetitions and the load, as the sheet shows it.</summary>
    private static IReadOnlyList<string> Performed(IEnumerable<PerformedSetResponse> sets) =>
        [.. sets.Select(set => set.LoadKilograms > 0m
            ? $"{set.Repetitions}x {set.LoadKilograms:0.##}kg"
            : $"{set.Repetitions}x peso corporal")];

    private static decimal Volume(TodayWorkoutResponse today) =>
        today.Sets.Sum(set => set.LoadKilograms * set.Repetitions);

    private string ExerciseName(Guid exerciseId) =>
        _catalog.FirstOrDefault(exercise => exercise.Id == exerciseId)?.Name ?? exerciseId.ToString();

    /// <summary>
    /// The running clock. It counts from the seconds the server measured and adds only the time that
    /// passed on this page, so a skewed browser clock cannot invent a duration.
    /// </summary>
    private string Clock(TodayWorkoutResponse today) =>
        DisplayText.Duration(today.ElapsedSeconds + (int)(DateTimeOffset.UtcNow - _loadedAt).TotalSeconds);

    private sealed record ComparisonRow(
        Guid? ExerciseId,
        string ExerciseName,
        int Sets,
        int Repetitions,
        decimal? PrescribedLoad,
        IReadOnlyList<string> Performed,
        int RestSeconds,
        bool IsCompleted);
}
