@page "/series"
@attribute [Authorize]
@inject FitTrackApiClient Api
@inject ToastService Toasts

<PageTitle>Séries de treino — FitTrack</PageTitle>

<PageHeader Eyebrow="Gestão"
            Title="Séries de treino"
            Subtitle="Cada série pertence a um atleta: monte os treinos para ele.">
    <Actions>
        <a class="btn btn-secondary" href="/athletes">
            <AppIcon Name="users" Size="18" />
            Atletas
        </a>
    </Actions>
</PageHeader>

<div class="alert alert--info" style="margin-bottom: 26px;">
    <AppIcon Name="info" Size="18" />
    <span>
        Cada série pertence a um atleta. O personal cria a dele em
        <a href="/athletes">Atletas</a>; quem tem a liberação do administrador cria a sua em
        <a href="/meu-plano">Meu plano</a>.
    </span>
</div>

@if (_blocked)
{
    <div class="empty-state">
        <AppIcon Name="lock" Size="28" />
        <h2>Você ainda não pode montar séries</h2>
        <p>
            Montar uma série precisa de um personal — ou da liberação do administrador para montar o
            seu próprio treino.
        </p>
    </div>
}
else
{
    <SearchField Value="@_search" ValueChanged="SearchAsync"
                 Placeholder="Buscar série por nome"
                 AriaLabel="Buscar série por nome" />

    @if (_loading)
    {
        <div class="loading-state">
            <span class="spinner"></span>
            <span>Carregando séries…</span>
        </div>
    }
    else if (_totalCount == 0)
    {
        <div class="empty-state">
            <AppIcon Name="@(HasSearch ? "search" : "layers")" Size="28" />
            <h2>@(HasSearch ? "Nada encontrado" : "Nenhuma série ainda")</h2>
            <p>
                @(HasSearch
                    ? "Tente outro nome de série."
                    : "Crie a primeira série em Atletas — ou, se você tem a liberação do administrador, em Meu plano — e comece a montar os treinos A–E.")
            </p>
            @if (HasSearch)
            {
                <button class="btn btn-secondary" type="button" @onclick="ClearSearchAsync">Limpar busca</button>
            }
        </div>

        <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
    }
    else
    {
        <div class="section-head" style="margin-top: 22px;">
            <h2>Suas séries</h2>
            <span class="muted" style="font-size: 0.84rem;">@_totalCount @(_totalCount == 1 ? "série" : "séries")</span>
        </div>

        <div class="card-grid">
            @foreach (var row in _rows)
            {
                <article class="card series-card" @key="row.Id">
                    <div class="series-head">
                        <span class="icon-tile"><AppIcon Name="layers" /></span>
                        <div style="min-width: 0;">
                            <h2>@row.Name</h2>
                            <p>@row.WorkoutCount @(row.WorkoutCount == 1 ? "treino" : "treinos")</p>
                        </div>
                    </div>

                    <div class="inline-form">
                        <div class="field">
                            <label for="series-rename-@row.Id">Renomear</label>
                            <input id="series-rename-@row.Id" maxlength="80" @bind="row.Name" />
                        </div>

                        <button class="btn btn-secondary" type="button" disabled="@_busy" @onclick="() => RenameAsync(row)">
                            Salvar nome
                        </button>
                    </div>

                    <div class="actions" style="margin-top: 14px;">
                        <a class="btn btn-primary btn-block" href="/series/@row.Id">
                            Abrir série
                            <AppIcon Name="chevron-right" Size="18" />
                        </a>
                    </div>

                    <div style="margin-top: 14px;">
                        <button class="btn btn-secondary btn-sm btn-block" type="button" disabled="@_busy"
                                @onclick="() => ToggleFollowersAsync(row)">
                            <AppIcon Name="users" Size="16" />
                            Atletas seguindo
                        </button>

                        @if (row.FollowersOpen)
                        {
                            <div class="inline-form" style="margin-top: 10px;">
                                @if (row.LoadingFollowers)
                                {
                                    <div class="loading-state" style="padding: 8px 0;">
                                        <span class="spinner"></span>
                                        <span>Carregando…</span>
                                    </div>
                                }
                                else if (row.Followers.Count == 0)
                                {
                                    <p class="muted" style="margin: 0;">Nenhum atleta está seguindo esta série.</p>
                                }
                                else
                                {
                                    <ul style="margin: 0; padding-left: 0; list-style: none;">
                                        @foreach (var follower in row.Followers)
                                        {
                                            <li style="display: flex; justify-content: space-between; gap: 8px; padding: 4px 0;">
                                                <span>@FollowerLabel(follower.Name, follower.Email)</span>
                                                <span class="chip @(follower.IsOpen && follower.DaysRemaining > 0 ? "chip--success" : "")">
                                                    @FollowerTerm(follower.IsOpen, follower.DaysRemaining)
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
    }
}

@code {
    private const int PageSize = 12;

    private IReadOnlyList<SeriesRow> _rows = [];
    private bool _loading = true;
    private bool _busy;
    private string _search = string.Empty;
    private int _page = 1;
    private int _totalCount;
    private int _loadVersion;

    /// <summary>True when the API refuses: the caller may not author a series.</summary>
    private bool _blocked;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task SearchAsync(string value)
    {
        _search = value;
        _page = 1;
        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await ReloadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _page = 1;
        await ReloadAsync();
    }

    private async Task RenameAsync(SeriesRow row) =>
        await RunAsync(async () =>
        {
            await Api.RenameWorkoutSeriesAsync(row.Id, new SetWorkoutSeriesNameRequest(row.Name));
            await ReloadAsync();
        });

    /// <summary>
    /// First tap opens the section and loads the followers — one request per open card, never one
    /// for the whole page. Tapping again closes it; the names stay for the next open.
    /// </summary>
    private async Task ToggleFollowersAsync(SeriesRow row)
    {
        row.FollowersOpen = !row.FollowersOpen;

        if (!row.FollowersOpen || row.FollowersLoaded)
        {
            return;
        }

        row.LoadingFollowers = true;
        StateHasChanged();

        try
        {
            row.Followers =
            [
                .. await Api.ListSeriesFollowersAsync(row.Id),
            ];
            row.FollowersLoaded = true;
        }
        catch (ApiException exception)
        {
            row.FollowersOpen = false;
            Toasts.Error(ErrorMessages.Describe(exception));
        }
        finally
        {
            row.LoadingFollowers = false;
        }
    }

    /// <summary>
    /// Who the athlete trains with rules the label here too: the name carries the read while the
    /// account has none, and the e-mail stands in so nothing renders empty.
    /// </summary>
    private static string FollowerLabel(string? name, string email) =>
        !string.IsNullOrWhiteSpace(name) ? name : email;

    /// <summary>
    /// The state of the term: days left while they still run, "último dia" on the last whole day,
    /// and the closed chip once the trainer ended the cycle or the term ran out (the read answers
    /// zero days for both — the expiry is in the past even though the link stays open).
    /// </summary>
    private static string FollowerTerm(bool isOpen, int daysRemaining)
    {
        if (!isOpen || daysRemaining <= 0)
        {
            // The trainer already closed it — or the link is open but the term is in the past.
            return "ciclo encerrado";
        }

        return daysRemaining == 1 ? "último dia" : $"{daysRemaining} dias restantes";
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        // The last request made owns the screen; a late answer from a previous search is discarded.
        var version = ++_loadVersion;
        _loading = true;

        try
        {
            var result = await Api.GetWorkoutSeriesPageAsync(_search, _page, PageSize);

            if (version != _loadVersion)
            {
                return;
            }

            _rows =
            [
                .. result.Items.Select(series => new SeriesRow
                {
                    Id = series.Id,
                    Name = series.Name,
                    WorkoutCount = series.Workouts.Count,
                }),
            ];

            _totalCount = result.TotalCount;
        }
        catch (ApiException exception)
        {
            if (version != _loadVersion)
            {
                return;
            }

            // The caller may not author a series: the screen says what is missing instead of
            // failing with a toast nobody can act on.
            if (exception.StatusCode == HttpStatusCode.Forbidden)
            {
                _rows = [];
                _totalCount = 0;
                _blocked = true;
                return;
            }

            Toasts.Error(ErrorMessages.Describe(exception));
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private sealed class SeriesRow
    {
        public Guid Id { get; init; }

        public string Name { get; set; } = string.Empty;

        public int WorkoutCount { get; init; }

        public bool FollowersOpen { get; set; }

        public bool FollowersLoaded { get; set; }

        public bool LoadingFollowers { get; set; }

        public IReadOnlyList<SeriesFollowerResponse> Followers { get; set; } = [];
    }
}
