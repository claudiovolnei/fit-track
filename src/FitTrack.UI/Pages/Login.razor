@page "/login"
@inject FitTrackApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1>Sign in</h1>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="field">
        <label for="login-email">Email</label>
        <InputText id="login-email" type="email" @bind-Value="_model.Email" />
        <ValidationMessage For="() => _model.Email" />
    </div>

    <div class="field">
        <label for="login-password">Password</label>
        <InputText id="login-password" type="password" @bind-Value="_model.Password" />
        <ValidationMessage For="() => _model.Password" />
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <button type="submit" disabled="@_busy">@(_busy ? "Signing in…" : "Sign in")</button>
</EditForm>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var login = await Api.LoginAsync(new LoginRequest(_model.Email, _model.Password));
            await Session.SignInAsync(login.AccessToken);

            Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/workouts" : $"/{ReturnUrl.TrimStart('/')}");
        }
        catch (ApiException exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Model
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
