@page "/login"
@inject FitTrackApiClient Api
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Entrar — FitTrack</PageTitle>

<div class="auth-page">
    <AuthAside Eyebrow="Bem-vindo de volta"
               Title="Seu próximo treino começa aqui."
               Text="Entre para ver a ficha do seu personal, registrar séries e acompanhar tudo o que você já treinou."
               Points="@(new[] { "Sua série sempre à mão", "Repetições fixadas pelo seu personal", "Histórico completo de treinos" })" />

    <section class="auth-card card">
        <p class="eyebrow">Acesse sua conta</p>
        <h1>Entrar</h1>
        <p class="muted">Continue de onde você parou.</p>

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="login-email">E-mail</label>
                <InputText id="login-email" type="email" autocomplete="email" placeholder="voce@exemplo.com"
                           @bind-Value="_model.Email" />
                <ValidationMessage For="() => _model.Email" />
            </div>

            <div class="field">
                <label for="login-password">Senha</label>
                <InputText id="login-password" type="password" autocomplete="current-password" placeholder="••••••••"
                           @bind-Value="_model.Password" />
                <ValidationMessage For="() => _model.Password" />
            </div>

            @if (_error is not null)
            {
                <div class="alert alert--error">
                    <AppIcon Name="info" Size="18" />
                    <span>@_error</span>
                </div>
            }

            <button class="btn btn-primary btn-block" type="submit" disabled="@_busy">
                @(_busy ? "Entrando…" : "Entrar")
            </button>
        </EditForm>

        <p class="auth-switch">
            Ainda não tem conta? <a href="/register">Criar conta</a>
        </p>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly Model _model = new();
    private bool _busy;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var login = await Api.LoginAsync(new LoginRequest(_model.Email, _model.Password));
            await Session.SignInAsync(login.AccessToken);

            Navigation.NavigateTo(Landing(login.AccessToken));
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class Model
    {
        [Required(ErrorMessage = "Informe seu e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe sua senha.")]
        public string Password { get; set; } = string.Empty;
    }

    /// <summary>
    /// Where the user lands after signing in: the trainer opens his series, the athlete opens today's
    /// workout. A deep link in <c>returnUrl</c> always wins.
    /// </summary>
    private string Landing(string accessToken) =>
        string.IsNullOrWhiteSpace(ReturnUrl)
            ? IsPersonalTrainer(accessToken) ? "/series" : "/today"
            : $"/{ReturnUrl.TrimStart('/')}";

    private static bool IsPersonalTrainer(string accessToken) =>
        JwtReader.ReadClaims(accessToken)
            .Any(claim => claim.Type == ClaimTypes.Role && claim.Value == "PersonalTrainer");
}
