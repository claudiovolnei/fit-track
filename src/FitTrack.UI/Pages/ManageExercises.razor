@page "/exercises/manage"
@attribute [Authorize(Roles = "PersonalTrainer")]
@inject FitTrackApiClient Api

<PageTitle>Gerenciar catálogo — FitTrack</PageTitle>

<PageHeader Eyebrow="Gestão"
            Title="Gerenciar catálogo"
            Subtitle="Organize os grupos musculares e mantenha os exercícios disponíveis para as séries." />

@if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}

@if (_notice is not null)
{
    <div class="alert alert--info">
        <AppIcon Name="info" Size="18" />
        <span>@_notice</span>
    </div>
}

<div class="manage-grid">
    <section class="card">
        <div class="section-head">
            <h2>Grupos musculares</h2>
            <span class="chip">@_groupTotal</span>
        </div>

        <EditForm Model="_newGroup" OnValidSubmit="CreateGroupAsync">
            <DataAnnotationsValidator />

            <div class="inline-form">
                <div class="field">
                    <label for="new-group">Nome do grupo</label>
                    <InputText id="new-group" placeholder="Ex.: Peito" @bind-Value="_newGroup.Name" />
                    <ValidationMessage For="() => _newGroup.Name" />
                </div>

                <button class="btn btn-primary" type="submit" disabled="@_busy">
                    <AppIcon Name="plus" Size="18" />
                    Adicionar
                </button>
            </div>
        </EditForm>

        <hr class="divider" />

        <SearchField Value="@_groupSearch" ValueChanged="SearchGroupsAsync"
                     Placeholder="Buscar grupo por nome"
                     AriaLabel="Buscar grupo muscular por nome" />

        @if (_groupTotal == 0)
        {
            <p class="muted" style="font-size: 0.86rem;">
                @(HasGroupSearch
                    ? "Nenhum grupo encontrado."
                    : "Nenhum grupo ainda — crie um antes de cadastrar exercícios.")
            </p>

            <Pagination Page="_groupPage" PageSize="PageSize" TotalCount="_groupTotal"
                        PageChanged="GoToGroupPageAsync" />
        }
        else
        {
            <div class="entity-list">
                @foreach (var group in _groups)
                {
                    <div class="entity-row entity-row--group" @key="group.Id">
                        <div class="field">
                            <label for="group-name-@group.Id">Grupo</label>
                            <input id="group-name-@group.Id" @bind="group.Name" />
                        </div>

                        <div class="entity-row-actions">
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                    @onclick="() => SaveGroupAsync(group)">
                                Salvar
                            </button>
                        </div>
                    </div>
                }
            </div>

            <Pagination Page="_groupPage" PageSize="PageSize" TotalCount="_groupTotal"
                        PageChanged="GoToGroupPageAsync" />
        }
    </section>

    <section class="card">
        <div class="section-head">
            <h2>Novo exercício</h2>
            <span class="chip">@_exerciseTotal no catálogo</span>
        </div>

        <EditForm Model="_create" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />

            <div class="field">
                <label for="new-name">Nome do exercício</label>
                <InputText id="new-name" placeholder="Ex.: Supino reto" @bind-Value="_create.Name" />
                <ValidationMessage For="() => _create.Name" />
            </div>

            <div class="field">
                <label for="new-exercise-group">Grupo muscular</label>
                <SearchableSelect Id="new-exercise-group"
                                  Options="GroupOptions"
                                  Value="_create.MuscleGroupId"
                                  ValueChanged="SetCreateGroup"
                                  Placeholder="Selecione um grupo…"
                                  FilterPlaceholder="Buscar grupo"
                                  EmptyText="Nenhum grupo encontrado"
                                  AriaLabel="Grupo muscular" />
            </div>

            <button class="btn btn-primary btn-block" type="submit" disabled="@(_busy || _allGroups.Count == 0)">
                <AppIcon Name="plus" Size="18" />
                Adicionar exercício
            </button>
        </EditForm>
    </section>
</div>

<section class="section">
    <div class="section-head">
        <h2>Exercícios</h2>
        <span class="muted" style="font-size: 0.84rem;">@_exerciseTotal @(_exerciseTotal == 1 ? "exercício" : "exercícios")</span>
    </div>

    <SearchField Value="@_exerciseSearch" ValueChanged="SearchExercisesAsync"
                 Placeholder="Buscar exercício por nome"
                 AriaLabel="Buscar exercício por nome" />

    @if (_exerciseTotal == 0)
    {
        <div class="empty-state">
            <AppIcon Name="@(HasExerciseSearch ? "search" : "library")" Size="28" />
            <h2>@(HasExerciseSearch ? "Nada encontrado" : "Nada para gerenciar ainda")</h2>
            <p>@(HasExerciseSearch ? "Tente outro nome." : "Cadastre o primeiro exercício no formulário acima.")</p>
            @if (HasExerciseSearch)
            {
                <button class="btn btn-secondary" type="button" @onclick="ClearExerciseSearchAsync">Limpar busca</button>
            }
        </div>

        <Pagination Page="_exercisePage" PageSize="PageSize" TotalCount="_exerciseTotal"
                    PageChanged="GoToExercisePageAsync" />
    }
    else
    {
        <div class="card card--flat">
            <div class="entity-list">
                @foreach (var row in _rows)
                {
                    <div class="entity-row" @key="row.Id">
                        <div class="field">
                            <label for="exercise-name-@row.Id">Nome</label>
                            <input id="exercise-name-@row.Id" @bind="row.Name" />
                        </div>

                        <div class="field">
                            <label for="exercise-group-@row.Id">Grupo</label>
                            <SearchableSelect Id="@($"exercise-group-{row.Id}")"
                                              Options="GroupOptions"
                                              Value="row.MuscleGroupId"
                                              ValueChanged="id => SetRowGroup(row, id)"
                                              Placeholder="Selecione um grupo…"
                                              FilterPlaceholder="Buscar grupo"
                                              EmptyText="Nenhum grupo encontrado"
                                              AriaLabel="Grupo muscular" />
                        </div>

                        <label class="switch">
                            <input type="checkbox" @bind="row.IsActive" />
                            Ativo
                        </label>

                        <div class="entity-row-actions">
                            <button class="btn btn-secondary btn-sm" type="button" disabled="@_busy"
                                    @onclick="() => SaveAsync(row)">
                                Salvar
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <Pagination Page="_exercisePage" PageSize="PageSize" TotalCount="_exerciseTotal"
                    PageChanged="GoToExercisePageAsync" />
    }
</section>

@code {
    private const int PageSize = 20;

    private readonly Model _newGroup = new();
    private readonly Model _create = new();
    private List<GroupRowModel> _groups = [];
    private List<RowModel> _rows = [];
    private IReadOnlyList<MuscleGroupResponse> _allGroups = [];
    private bool _busy;
    private string? _error;
    private string? _notice;
    private string _groupSearch = string.Empty;
    private int _groupPage = 1;
    private int _groupTotal;
    private string _exerciseSearch = string.Empty;
    private int _exercisePage = 1;
    private int _exerciseTotal;
    private int _loadVersion;

    private bool HasGroupSearch => !string.IsNullOrWhiteSpace(_groupSearch);

    private bool HasExerciseSearch => !string.IsNullOrWhiteSpace(_exerciseSearch);

    private IReadOnlyList<SearchableOption> GroupOptions =>
    [
        .. _allGroups.Select(group => new SearchableOption(group.Id, group.Name)),
    ];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task CreateGroupAsync()
    {
        var name = _newGroup.Name.Trim();

        await RunAsync(async () =>
        {
            await Api.CreateMuscleGroupAsync(new CreateMuscleGroupRequest(name));
            _newGroup.Name = string.Empty;
            _groupSearch = name;
            _groupPage = 1;
            _notice = "Grupo criado.";
        });
    }

    private async Task SaveGroupAsync(GroupRowModel group)
    {
        await RunAsync(async () =>
        {
            await Api.UpdateMuscleGroupAsync(group.Id, new UpdateMuscleGroupRequest(group.Name));
            _notice = "Grupo atualizado.";
        });
    }

    private async Task CreateAsync()
    {
        if (_create.MuscleGroupId == Guid.Empty)
        {
            _error = "Selecione um grupo muscular para o exercício.";
            return;
        }

        var name = _create.Name.Trim();

        await RunAsync(async () =>
        {
            await Api.CreateExerciseAsync(new CreateExerciseRequest(name, _create.MuscleGroupId));
            _create.Name = string.Empty;
            _create.MuscleGroupId = Guid.Empty;
            _exerciseSearch = name;
            _exercisePage = 1;
            _notice = "Exercício criado.";
        });
    }

    private async Task SaveAsync(RowModel row)
    {
        await RunAsync(async () =>
        {
            await Api.UpdateExerciseAsync(
                row.Id,
                new UpdateExerciseRequest(row.Name, row.MuscleGroupId, row.IsActive));
            _notice = "Exercício atualizado.";
        });
    }

    private async Task SearchGroupsAsync(string value)
    {
        _groupSearch = value;
        _groupPage = 1;
        await ReloadAsync();
    }

    private async Task GoToGroupPageAsync(int page)
    {
        _groupPage = page;
        await ReloadAsync();
    }

    private async Task SearchExercisesAsync(string value)
    {
        _exerciseSearch = value;
        _exercisePage = 1;
        await ReloadAsync();
    }

    private async Task GoToExercisePageAsync(int page)
    {
        _exercisePage = page;
        await ReloadAsync();
    }

    private async Task ClearExerciseSearchAsync()
    {
        _exerciseSearch = string.Empty;
        _exercisePage = 1;
        await ReloadAsync();
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        _notice = null;

        try
        {
            await action();
            await ReloadAsync();
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        // Group search, exercise search and their paginations can overlap; the newest snapshot wins.
        var version = ++_loadVersion;

        try
        {
            var groups = await Api.GetMuscleGroupsPageAsync(_groupSearch, _groupPage, PageSize);
            var exercises = await Api.GetExercisesPageAsync(_exerciseSearch, null, _exercisePage, PageSize);
            var allGroups = await Api.GetMuscleGroupsAsync();

            if (version != _loadVersion)
            {
                return;
            }

            _groups = [.. groups.Items.Select(GroupRowModel.From)];
            _rows = [.. exercises.Items.Select(RowModel.From)];
            _allGroups = allGroups;
            _groupTotal = groups.TotalCount;
            _exerciseTotal = exercises.TotalCount;
        }
        catch (ApiException exception)
        {
            if (version != _loadVersion)
            {
                return;
            }

            _error = ErrorMessages.Describe(exception);
        }
    }

    private void SetCreateGroup(Guid groupId) => _create.MuscleGroupId = groupId;

    private static void SetRowGroup(RowModel row, Guid groupId) => row.MuscleGroupId = groupId;

    private sealed class Model
    {
        [Required(ErrorMessage = "Informe um nome.")]
        public string Name { get; set; } = string.Empty;

        public Guid MuscleGroupId { get; set; } = Guid.Empty;
    }

    private sealed class GroupRowModel
    {
        public Guid Id { get; init; }

        public string Name { get; set; } = string.Empty;

        public static GroupRowModel From(MuscleGroupResponse group) => new()
        {
            Id = group.Id,
            Name = group.Name,
        };
    }

    private sealed class RowModel
    {
        public Guid Id { get; init; }

        public string Name { get; set; } = string.Empty;

        public Guid MuscleGroupId { get; set; }

        public bool IsActive { get; set; }

        public static RowModel From(ExerciseResponse exercise) => new()
        {
            Id = exercise.Id,
            Name = exercise.Name,
            MuscleGroupId = exercise.MuscleGroupId,
            IsActive = exercise.IsActive,
        };
    }
}
