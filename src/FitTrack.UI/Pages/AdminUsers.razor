@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject FitTrackApiClient Api

<PageTitle>Usuários — FitTrack</PageTitle>

<PageHeader Eyebrow="Administração"
            Title="Usuários"
            Subtitle="Crie contas e conceda os perfis. O cadastro público continua aberto para quem chega sozinho.">
    <Actions>
        <a class="btn btn-secondary" href="/exercises">
            <AppIcon Name="library" Size="18" />
            Ver catálogo
        </a>
    </Actions>
</PageHeader>

@if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}

<section class="card card--accent" style="margin-bottom: 26px;">
    <div class="section-head">
        <h2>Nova conta</h2>
        <span class="chip">Você escolhe os perfis</span>
    </div>

    <EditForm Model="_new" OnValidSubmit="CreateAsync">
        <DataAnnotationsValidator />

        <div class="field-row">
            <div class="field">
                <label for="user-name">Nome</label>
                <InputText id="user-name" placeholder="Como a pessoa aparece no app" @bind-Value="_new.Name" />
                <ValidationMessage For="() => _new.Name" />
            </div>

            <div class="field">
                <label for="user-email">E-mail</label>
                <InputText id="user-email" type="email" placeholder="pessoa@exemplo.com"
                           @bind-Value="_new.Email" />
                <ValidationMessage For="() => _new.Email" />
            </div>
        </div>

        <div class="field">
            <label for="user-password">Senha</label>
            <InputText id="user-password" type="password" placeholder="Pelo menos 8 caracteres"
                       @bind-Value="_new.Password" />
            <ValidationMessage For="() => _new.Password" />
        </div>

        <div class="field">
            <label>Perfis</label>
            <div class="role-picker">
                <label class="role-option">
                    <InputCheckbox @bind-Value="_new.IsAthlete" />
                    <span>@DisplayText.RoleLabel("User")</span>
                </label>
                <label class="role-option">
                    <InputCheckbox @bind-Value="_new.IsTrainer" />
                    <span>@DisplayText.RoleLabel("PersonalTrainer")</span>
                </label>
                <label class="role-option">
                    <InputCheckbox @bind-Value="_new.IsAdmin" />
                    <span>@DisplayText.RoleLabel("Admin")</span>
                </label>
            </div>
        </div>

        <button class="btn btn-primary btn-block" type="submit" disabled="@(_busy || _new.Roles.Count == 0)">
            <AppIcon Name="plus" Size="18" />
            Criar conta
        </button>
    </EditForm>
</section>

<SearchField Value="@_search" ValueChanged="SearchAsync"
             Placeholder="Buscar conta por nome ou e-mail"
             AriaLabel="Buscar conta por nome ou e-mail" />

@if (_loading)
{
    <div class="loading-state" style="margin-top: 20px;">
        <span class="spinner"></span>
        <span>Carregando usuários…</span>
    </div>
}
else if (_totalCount == 0)
{
    <div class="empty-state">
        <AppIcon Name="@(HasSearch ? "search" : "users")" Size="28" />
        <h2>@(HasSearch ? "Nada encontrado" : "Nenhuma conta ainda")</h2>
        <p>@(HasSearch ? "Tente outro nome ou e-mail." : "Crie a primeira conta no formulário acima.")</p>
        @if (HasSearch)
        {
            <button class="btn btn-secondary" type="button" @onclick="ClearSearchAsync">Limpar busca</button>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}
else
{
    <div class="section-head" style="margin-top: 22px;">
        <h2>Contas</h2>
        <span class="muted" style="font-size: 0.84rem;">@_totalCount @(_totalCount == 1 ? "conta" : "contas")</span>
    </div>

    <div class="card-grid">
        @foreach (var user in _users)
        {
            <article class="card user-card" @key="user.UserId">
                <div class="user-head">
                    <UserAvatar AvatarUrl="@(_avatars.TryGetValue(user.UserId, out var url) ? url : null)"
                                NameOrEmail="@user.Name" Size="46" CssClass="avatar--lg" />
                    <div style="min-width: 0;">
                        <h2>@user.Name</h2>
                        @* A legacy account without a name arrives here with the e-mail standing in for it
                           (the read side's fallback), so the line below would repeat the heading; it only
                           renders when it adds something. *@
                        @if (!string.Equals(user.Name, user.Email, StringComparison.OrdinalIgnoreCase))
                        {
                            <p>@user.Email</p>
                        }
                    </div>
                </div>

                <div class="user-status">
                    @if (user.Roles.Count == 0)
                    {
                        <span class="chip chip--danger">Sem perfil</span>
                    }
                    else
                    {
                        @foreach (var role in user.Roles)
                        {
                            <span class="chip chip--accent">@DisplayText.RoleLabel(role)</span>
                        }
                    }
                </div>

                <div class="actions">
                    @foreach (var role in DisplayText.Roles)
                    {
                        var granted = user.Roles.Contains(role);

                        <button class="btn btn-sm @(granted ? "btn-danger" : "btn-secondary")" type="button"
                                disabled="@_busy" @onclick="() => ToggleRoleAsync(user, role, granted)">
                            <AppIcon Name="@(granted ? "trash" : "plus")" Size="16" />
                            @(granted ? "Revogar" : "Conceder") @DisplayText.RoleLabel(role)
                        </button>
                    }

                    <button class="btn btn-sm btn-secondary" type="button"
                            disabled="@_busy" @onclick="() => StartResetAsync(user.UserId)">
                        <AppIcon Name="edit" Size="16" />
                        Redefinir senha
                    </button>
                </div>

                @if (_resettingUserId == user.UserId)
                {
                    <div class="reset-password">
                        <input type="password" placeholder="Nova senha" @bind="_resetPassword" />
                        @if (_resetError is not null)
                        {
                            <span class="field-error">@_resetError</span>
                        }
                        <div class="actions">
                            <button class="btn btn-sm btn-primary" type="button" disabled="@_busy"
                                    @onclick="() => ConfirmResetAsync(user.UserId)">
                                Salvar
                            </button>
                            <button class="btn btn-sm btn-secondary" type="button" disabled="@_busy"
                                    @onclick="CancelResetAsync">
                                Cancelar
                            </button>
                        </div>
                    </div>
                }
            </article>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}

@code {
    private const int PageSize = 12;

    private IReadOnlyList<UserAccountResponse> _users = [];
    private readonly Dictionary<Guid, string?> _avatars = new();
    private readonly NewUser _new = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private Guid? _resettingUserId;
    private string _resetPassword = string.Empty;
    private string? _resetError;
    private string _search = string.Empty;
    private int _page = 1;
    private int _totalCount;
    private int _loadVersion;

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync() => await RunAsync(ReloadAsync);

    private async Task SearchAsync(string value)
    {
        _search = value;
        _page = 1;
        await RunAsync(ReloadAsync);
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await RunAsync(ReloadAsync);
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _page = 1;
        await RunAsync(ReloadAsync);
    }

    private async Task CreateAsync() =>
        await RunAsync(async () =>
        {
            await Api.CreateUserAsync(new CreateUserRequest(_new.Name, _new.Email, _new.Password, _new.Roles));

            _new.Reset();

            await ReloadAsync();
        });

    private async Task ToggleRoleAsync(UserAccountResponse user, string role, bool granted) =>
        await RunAsync(async () =>
        {
            if (granted)
            {
                await Api.RevokeRoleAsync(user.UserId, role);
            }
            else
            {
                await Api.GrantRoleAsync(user.UserId, role);
            }

            await ReloadAsync();
        });

    private void StartResetAsync(Guid userId)
    {
        _resettingUserId = userId;
        _resetPassword = string.Empty;
        _resetError = null;
    }

    private void CancelResetAsync()
    {
        _resettingUserId = null;
        _resetPassword = string.Empty;
        _resetError = null;
    }

    private async Task ConfirmResetAsync(Guid userId)
    {
        if (string.IsNullOrWhiteSpace(_resetPassword))
        {
            _resetError = "Informe a nova senha.";
            return;
        }

        _busy = true;
        _resetError = null;
        try
        {
            await Api.ResetPasswordAsync(userId, new ResetPasswordRequest(_resetPassword));
            CancelResetAsync();
        }
        catch (ApiException exception)
        {
            _resetError = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;

        try
        {
            await action();
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadAsync()
    {
        // The last request made owns the screen, including the avatars it resolves one by one.
        var version = ++_loadVersion;
        _loading = true;

        try
        {
            var result = await Api.GetUsersPageAsync(_search, _page, PageSize);

            if (version != _loadVersion)
            {
                return;
            }

            _users = result.Items;
            _totalCount = result.TotalCount;

            _avatars.Clear();
            foreach (var user in _users.Where(u => u.HasAvatar))
            {
                string? avatar;
                try
                {
                    avatar = await Api.GetUserAvatarAsync(user.UserId);
                }
                catch
                {
                    avatar = null;
                }

                if (version != _loadVersion)
                {
                    return;
                }

                _avatars[user.UserId] = avatar;
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    /// <summary>The form of a new account, validated before becoming the body of the POST.</summary>
    private sealed class NewUser
    {
        [Required(ErrorMessage = "Informe o nome.")]
        [MaxLength(80, ErrorMessage = "Use no máximo 80 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe o e-mail.")]
        [EmailAddress(ErrorMessage = "Informe um e-mail válido.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Informe a senha.")]
        [MinLength(8, ErrorMessage = "A senha precisa de pelo menos 8 caracteres.")]
        public string Password { get; set; } = string.Empty;

        public bool IsAthlete { get; set; } = true;

        public bool IsTrainer { get; set; }

        public bool IsAdmin { get; set; }

        /// <summary>The checked profiles, in the order the app presents them.</summary>
        public IReadOnlyList<string> Roles =>
            [.. DisplayText.Roles.Where(role => role switch
            {
                "Admin" => IsAdmin,
                "PersonalTrainer" => IsTrainer,
                _ => IsAthlete,
            })];

        public void Reset()
        {
            Name = string.Empty;
            Email = string.Empty;
            Password = string.Empty;
            IsAthlete = true;
            IsTrainer = false;
            IsAdmin = false;
        }
    }
}
