@page "/workouts"
@attribute [Authorize]
@inject FitTrackApiClient Api

<PageTitle>Meus treinos — FitTrack</PageTitle>

<PageHeader Eyebrow="Histórico"
            Title="Meus treinos"
            Subtitle="Tudo o que você já registrou, do mais recente ao mais antigo.">
    <Actions>
        <a class="btn btn-primary" href="/today">
            <AppIcon Name="play" Size="18" />
            Treino de hoje
        </a>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando seu histórico…</span>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert--error">
        <AppIcon Name="info" Size="18" />
        <span>@_error</span>
    </div>
}
else if (_sessions.Count == 0)
{
    <div class="empty-state">
        <AppIcon Name="history" Size="28" />
        <h2>Nenhum treino registrado ainda</h2>
        <p>Seu primeiro treino aparece aqui assim que você iniciar uma sessão.</p>
        <a class="btn btn-primary" href="/today">Começar agora</a>
    </div>
}
else
{
    <div class="stat-grid" style="margin-bottom: 22px;">
        <article class="stat">
            <span class="stat-label">Treinos</span>
            <span class="stat-value">@_sessions.Count</span>
        </article>
        <article class="stat">
            <span class="stat-label">Séries</span>
            <span class="stat-value">@_sessions.Sum(session => session.Sets.Count)</span>
        </article>
        <article class="stat">
            <span class="stat-label">Volume</span>
            <span class="stat-value">@DisplayText.Volume(TotalVolume)</span>
        </article>
        <article class="stat">
            <span class="stat-label">Em andamento</span>
            <span class="stat-value">@_sessions.Count(session => session.IsRunning)</span>
        </article>
    </div>

    @foreach (var session in _sessions)
    {
        <SessionCard @key="session.Id" Session="session" ExerciseNames="_exerciseNames" />
    }
}

@code {
    private IReadOnlyList<WorkoutSessionResponse> _sessions = [];
    private IReadOnlyDictionary<Guid, string> _exerciseNames = new Dictionary<Guid, string>();
    private bool _loading = true;
    private string? _error;

    private decimal TotalVolume =>
        _sessions.SelectMany(session => session.Sets).Sum(set => set.LoadKilograms * set.Repetitions);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var exercises = await Api.GetExercisesAsync();
            _exerciseNames = exercises.ToDictionary(exercise => exercise.Id, exercise => exercise.Name);

            _sessions = await Api.GetSessionsAsync();
        }
        catch (ApiException exception)
        {
            _error = ErrorMessages.Describe(exception);
        }
        finally
        {
            _loading = false;
        }
    }
}
