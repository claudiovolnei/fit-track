@page "/workouts"
@attribute [Authorize]
@inject FitTrackApiClient Api
@inject ToastService Toasts

<PageTitle>Meus treinos — FitTrack</PageTitle>

<PageHeader Eyebrow="Histórico"
            Title="Meus treinos"
            Subtitle="Tudo o que você já registrou, do mais recente ao mais antigo.">
    <Actions>
        <a class="btn btn-primary" href="/today">
            <AppIcon Name="play" Size="18" />
            Treino de hoje
        </a>
    </Actions>
</PageHeader>

<SearchField Value="@_search" ValueChanged="SearchAsync"
             Placeholder="Buscar treino por nome"
             AriaLabel="Buscar treino por nome" />

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <span>Carregando seu histórico…</span>
    </div>
}
else if (_totalCount == 0)
{
    <div class="empty-state">
        <AppIcon Name="@(HasSearch ? "search" : "history")" Size="28" />
        <h2>@(HasSearch ? "Nada encontrado" : "Nenhum treino registrado ainda")</h2>
        <p>
            @(HasSearch
                ? "Tente outro nome de treino."
                : "Seu primeiro treino aparece aqui assim que você iniciar uma sessão.")
        </p>
        @if (HasSearch)
        {
            <button class="btn btn-secondary" type="button" @onclick="ClearSearchAsync">Limpar busca</button>
        }
        else
        {
            <a class="btn btn-primary" href="/today">Começar agora</a>
        }
    </div>

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}
else
{
    @if (_summary is not null)
    {
        <div class="stat-grid" style="margin-top: 22px; margin-bottom: 22px;">
            <article class="stat">
                <span class="stat-label">Treinos</span>
                <span class="stat-value">@_summary.SessionCount</span>
            </article>
            <article class="stat">
                <span class="stat-label">Séries</span>
                <span class="stat-value">@_summary.SetCount</span>
            </article>
            <article class="stat">
                <span class="stat-label">Volume feito</span>
                @if (_summary.PrescribedKilograms > 0m)
                {
                    <span class="stat-value @(_summary.DeltaKilograms > 0 ? "is-up" : _summary.DeltaKilograms < 0 ? "is-down" : "")">
                        @DisplayText.SignedLoad(_summary.DeltaKilograms)
                        <small>Prescrito @DisplayText.Load(_summary.PrescribedKilograms) · Feito @DisplayText.Load(_summary.PerformedKilograms) · média por exercício</small>
                    </span>
                }
                else
                {
                    <span class="stat-value">
                        —
                        <small>sem prescrição para comparar</small>
                    </span>
                }
            </article>
            <article class="stat">
                <span class="stat-label">Aumento</span>
                <span class="stat-value @(_summary.DeltaKilograms > 0 ? "is-up" : _summary.DeltaKilograms < 0 ? "is-down" : "")">
                    @(_summary.DeltaPercent is { } percent ? DisplayText.SignedPercent(percent) : "—")
                    @if (_summary.DeltaPercent is null)
                    {
                        <small>sem base de comparação</small>
                    }
                </span>
            </article>
        </div>
    }

    @foreach (var session in _sessions)
    {
        <SessionCard @key="session.Id" Session="session" ExerciseNames="_exerciseNames"
                     ExpandedKeys="_expandedGroups" GroupToggled="ToggleExpandedGroup" />
    }

    <Pagination Page="_page" PageSize="PageSize" TotalCount="_totalCount" PageChanged="GoToPageAsync" />
}

@code {
    private const int PageSize = 10;

    private IReadOnlyList<WorkoutSessionResponse> _sessions = [];
    private IReadOnlyDictionary<Guid, string> _exerciseNames = new Dictionary<Guid, string>();
    private WorkoutVolumeSummaryResponse? _summary;
    private bool _loading = true;
    private string _search = string.Empty;
    private int _page = 1;
    private int _totalCount;
    private int _loadVersion;

    // The screen owns the expansions, keyed by session and run position, so they survive the
    // full redraw that every search, page or reload rings through _loading.
    private readonly HashSet<string> _expandedGroups = [];

    private bool HasSearch => !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var exercises = await Api.GetExercisesAsync();
            _exerciseNames = exercises.ToDictionary(exercise => exercise.Id, exercise => exercise.Name);
        }
        catch (ApiException exception)
        {
            Toasts.Error(ErrorMessages.Describe(exception));
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // The latest request wins; an older answer arriving late must not replace the page on screen.
        var version = ++_loadVersion;
        _loading = true;

        try
        {
            var history = await Api.GetSessionsPageAsync(_search, _page, PageSize);

            if (version != _loadVersion)
            {
                return;
            }

            _sessions = history.Items;
            _summary = history.Summary;
            _totalCount = history.TotalCount;
        }
        catch (ApiException exception)
        {
            if (version != _loadVersion)
            {
                return;
            }

            Toasts.Error(ErrorMessages.Describe(exception));
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private async Task SearchAsync(string value)
    {
        _search = value;
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        _page = 1;
        await LoadAsync();
    }

    private void ToggleExpandedGroup(string key)
    {
        if (_expandedGroups.Contains(key))
        {
            _expandedGroups.Remove(key);
        }
        else
        {
            _expandedGroups.Add(key);
        }
    }
}
