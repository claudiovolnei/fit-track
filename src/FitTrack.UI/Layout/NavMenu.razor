@* App navigation: sidebar on desktop, top bar and bottom tabs on mobile. *@

@implements IDisposable

@inject UserSession Session
@inject NavigationManager Navigation
@inject FitTrackApiClient Api
@inject UserAvatarState AvatarState
@inject AuthenticationStateProvider AuthState

<aside class="sidebar" aria-label="Navegação principal">
    <a class="brand" href="/">
        <span class="brand-mark"><AppIcon Name="dumbbell" Size="22" /></span>
        <span class="brand-name">fit<span>track</span></span>
    </a>

    <nav class="side-nav">
        <span class="nav-label">Visão geral</span>
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <AppIcon Name="home" />
            <span>Início</span>
        </NavLink>

        <AuthorizeView Roles="User">
            <Authorized>
                <span class="nav-label">Treino</span>
                <NavLink class="nav-link" href="/today">
                    <AppIcon Name="dumbbell" />
                    <span>Hoje</span>
                </NavLink>
                <NavLink class="nav-link" href="/workouts">
                    <AppIcon Name="history" />
                    <span>Meus treinos</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="PersonalTrainer">
            <Authorized>
                <span class="nav-label">Gestão</span>
                <NavLink class="nav-link" href="/series">
                    <AppIcon Name="layers" />
                    <span>Séries de treino</span>
                </NavLink>
                <NavLink class="nav-link" href="/athletes">
                    <AppIcon Name="users" />
                    <span>Atletas</span>
                </NavLink>
                <NavLink class="nav-link" href="/exercises/manage">
                    <AppIcon Name="library" />
                    <span>Catálogo</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <span class="nav-label">Administração</span>
                <NavLink class="nav-link" href="/admin/users">
                    <AppIcon Name="users" />
                    <span>Usuários</span>
                </NavLink>
                <NavLink class="nav-link" href="/exercises">
                    <AppIcon Name="library" />
                    <span>Exercícios</span>
                </NavLink>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="user-chip">
                    <NavLink href="/account" class="avatar-link" title="Minha conta" aria-label="Minha conta">
                        <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@context.User.Identity?.Name" Size="38" />
                    </NavLink>
                    <span class="user-meta">
                        <strong>@DisplayText.NameFromEmail(context.User.Identity?.Name)</strong>
                        <small>@Role(context.User)</small>
                    </span>
                </div>
                <NavLink class="icon-button" href="/account" title="Minha conta" aria-label="Minha conta">
                    <AppIcon Name="user" />
                </NavLink>
                <button type="button" class="icon-button" title="Sair" aria-label="Sair" @onclick="SignOutAsync">
                    <AppIcon Name="logout" />
                </button>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary btn-block" href="/login">Entrar</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

<header class="topbar">
    <a class="brand brand--compact" href="/">
        <span class="brand-mark"><AppIcon Name="dumbbell" Size="19" /></span>
        <span class="brand-name">fit<span>track</span></span>
    </a>

    <AuthorizeView>
        <Authorized>
            <div class="topbar-user">
                <NavLink href="/account" class="avatar-link" title="Minha conta" aria-label="Minha conta">
                    <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@context.User.Identity?.Name" Size="34" CssClass="avatar--sm" />
                </NavLink>
                <button type="button" class="icon-button" title="Sair" aria-label="Sair" @onclick="SignOutAsync">
                    <AppIcon Name="logout" />
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-primary btn-sm" href="/login">Entrar</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<nav class="tabbar" aria-label="Navegação principal">
    <NavLink class="tab-link" href="/" Match="NavLinkMatch.All">
        <AppIcon Name="home" Size="22" />
        <span>Início</span>
    </NavLink>

    <AuthorizeView Roles="User">
        <Authorized>
            <NavLink class="tab-link" href="/today">
                <AppIcon Name="dumbbell" Size="22" />
                <span>Hoje</span>
            </NavLink>
            <NavLink class="tab-link" href="/workouts">
                <AppIcon Name="history" Size="22" />
                <span>Histórico</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="PersonalTrainer">
        <Authorized>
            <NavLink class="tab-link" href="/series">
                <AppIcon Name="layers" Size="22" />
                <span>Séries</span>
            </NavLink>
            <NavLink class="tab-link" href="/athletes">
                <AppIcon Name="users" Size="22" />
                <span>Atletas</span>
            </NavLink>
            <NavLink class="tab-link" href="/exercises/manage">
                <AppIcon Name="library" Size="22" />
                <span>Catálogo</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <NavLink class="tab-link" href="/admin/users">
                <AppIcon Name="users" Size="22" />
                <span>Usuários</span>
            </NavLink>
            <NavLink class="tab-link" href="/exercises">
                <AppIcon Name="library" Size="22" />
                <span>Exercícios</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <NavLink class="tab-link" href="/account">
                <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@context.User.Identity?.Name" Size="22" />
                <span>Conta</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView>
        <NotAuthorized>
            <NavLink class="tab-link" href="/login">
                <AppIcon Name="user" Size="22" />
                <span>Entrar</span>
            </NavLink>
            <NavLink class="tab-link" href="/register">
                <AppIcon Name="sparkles" Size="22" />
                <span>Criar conta</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? _avatarUrl;

    protected override void OnInitialized()
    {
        _avatarUrl = AvatarState.AvatarUrl;
        AvatarState.Changed += OnAvatarChanged;
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The layout outlives the login: the first render may happen while anonymous, so the
        // authenticated avatar is also fetched when the authentication state changes.
        await RefreshAvatarAsync(await AuthState.GetAuthenticationStateAsync());
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) =>
        _ = InvokeAsync(async () => await RefreshAvatarAsync(await state));

    private async Task RefreshAvatarAsync(AuthenticationState state)
    {
        if (state.User.Identity?.IsAuthenticated != true)
        {
            _avatarUrl = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var userKey = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? state.User.Identity.Name;

        await AvatarState.EnsureLoadedAsync(userKey, cancellationToken => Api.GetMyAvatarAsync(cancellationToken));

        _avatarUrl = AvatarState.AvatarUrl;
        await InvokeAsync(StateHasChanged);
    }

    private void OnAvatarChanged()
    {
        _avatarUrl = AvatarState.AvatarUrl;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AvatarState.Changed -= OnAvatarChanged;
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();

        // SPA navigation (no page reload): the token is already cleared, so the authentication
        // state drops to anonymous and the login screen takes over. A forceLoad here would race
        // with the redirect fired by the authentication change itself and could take down the
        // UI with an unexpected error.
        Navigation.NavigateTo("/login", replace: true);
    }

    // The highlighted profile is the strongest the account has, in the order of DisplayText.Roles.
    private static string Role(ClaimsPrincipal user) =>
        DisplayText.RoleLabel(DisplayText.Roles.FirstOrDefault(user.IsInRole) ?? "User");
}
