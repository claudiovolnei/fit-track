@* App navigation: sidebar on desktop, top bar and bottom tabs on mobile. *@
@* Both menus derive from NavOptions: one registry, the tabbar capped at four options plus "Mais". *@

@implements IDisposable

@inject UserSession Session
@inject NavigationManager Navigation
@inject FitTrackApiClient Api
@inject UserAvatarState AvatarState
@inject AuthenticationStateProvider AuthState

<aside class="sidebar" aria-label="Navegação principal">
    <a class="brand" href="/">
        <span class="brand-mark"><AppIcon Name="dumbbell" Size="22" /></span>
        <span class="brand-name">fit<span>track</span></span>
    </a>

    <nav class="side-nav">
        @foreach (NavSection group in NavOptions.Sidebar(LoggedInRoles, IsAuthenticated))
        {
            <span class="nav-label">@group.Label</span>
            @foreach (NavItem item in group.Items)
            {
                <NavLink class="nav-link" href="@item.Href" Match="@MatchFor(item)">
                    <AppIcon Name="@item.Icon" />
                    <span>@item.Label</span>
                </NavLink>
            }
        }
    </nav>

    <div class="sidebar-footer">
        <AuthorizeView>
            <Authorized>
                <div class="user-chip">
                    <NavLink href="/account" class="avatar-link" title="Minha conta" aria-label="Minha conta">
                        <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@context.User.Identity?.Name" Size="38" />
                    </NavLink>
                    <span class="user-meta">
                        <strong>@DisplayText.NameFromEmail(context.User.Identity?.Name)</strong>
                        <small>@Role(context.User)</small>
                    </span>
                </div>
                <NavLink class="icon-button" href="/account" title="Minha conta" aria-label="Minha conta">
                    <AppIcon Name="user" />
                </NavLink>
                <button type="button" class="icon-button" title="Sair" aria-label="Sair" @onclick="SignOutAsync">
                    <AppIcon Name="logout" />
                </button>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary btn-block" href="/login">Entrar</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</aside>

<header class="topbar">
    <a class="brand brand--compact" href="/">
        <span class="brand-mark"><AppIcon Name="dumbbell" Size="19" /></span>
        <span class="brand-name">fit<span>track</span></span>
    </a>

    <AuthorizeView>
        <Authorized>
            <div class="topbar-user">
                <NavLink href="/account" class="avatar-link" title="Minha conta" aria-label="Minha conta">
                    <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@context.User.Identity?.Name" Size="34" CssClass="avatar--sm" />
                </NavLink>
                <button type="button" class="icon-button" title="Sair" aria-label="Sair" @onclick="SignOutAsync">
                    <AppIcon Name="logout" />
                </button>
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-primary btn-sm" href="/login">Entrar</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<nav class="tabbar" aria-label="Navegação principal">
    @foreach (NavItem tab in NavOptions.Tabs(LoggedInRoles, IsAuthenticated).Tabs)
    {
        if (tab.Key == NavOptions.AccountKey)
        {
            <NavLink class="tab-link" href="@tab.Href" Match="@MatchFor(tab)" aria-label="Conta">
                <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@_user?.Identity?.Name" Size="22" />
                <span>Conta</span>
            </NavLink>
        }
        else
        {
            <NavLink class="tab-link" href="@tab.Href" Match="@MatchFor(tab)">
                <AppIcon Name="@tab.Icon" Size="22" />
                <span>@tab.Label</span>
            </NavLink>
        }
    }

    @if (NavOptions.Tabs(LoggedInRoles, IsAuthenticated).HasMore)
    {
        <button type="button" class="tab-link tab-link--more" aria-expanded="@_moreOpen"
                aria-label="Mais funcionalidades" @onclick="ToggleMore">
            <AppIcon Name="menu" Size="22" />
            <span>Mais</span>
        </button>
    }
</nav>

@if (_moreOpen)
{
    <div class="sheet-overlay" @onclick="CloseMore"></div>

    <div class="tab-sheet" role="dialog" aria-label="Mais funcionalidades">
        @foreach (SheetGroup group in NavOptions.Overflow(LoggedInRoles, IsAuthenticated))
        {
            <span class="sheet-label">@group.Label</span>
            @foreach (NavItem item in group.Items)
            {
                <NavLink class="sheet-link" href="@item.Href" Match="@MatchFor(item)" @onclick="CloseMore">
                    <AppIcon Name="@item.Icon" />
                    <span>@item.Label</span>
                </NavLink>
            }
        }

        <span class="sheet-label">Conta</span>
        <NavLink class="sheet-link" href="/account" Match="NavLinkMatch.All" @onclick="CloseMore">
            <UserAvatar AvatarUrl="@_avatarUrl" NameOrEmail="@_user?.Identity?.Name" Size="20" />
            <span>Minha conta</span>
        </NavLink>
        <button type="button" class="sheet-link sheet-link--danger" @onclick="SignOutAsync">
            <AppIcon Name="logout" />
            <span>Sair</span>
        </button>
    </div>
}

@code {
    private string? _avatarUrl;
    private ClaimsPrincipal? _user;
    private bool _moreOpen;

    private bool IsAuthenticated => _user?.Identity?.IsAuthenticated == true;

    // The registry checks membership on the role names it carries; the active highlight rules
    // mirror the claims, not the Authorization UI widgets, so both tabs and "Mais" agree.
    private string[] LoggedInRoles => IsAuthenticated
        ? [.. _user!.FindAll(ClaimTypes.Role).Select(claim => claim.Value)]
        : [];

    private static NavLinkMatch MatchFor(NavItem item) =>
        item.Exact ? NavLinkMatch.All : NavLinkMatch.Prefix;

    protected override void OnInitialized()
    {
        _avatarUrl = AvatarState.AvatarUrl;
        AvatarState.Changed += OnAvatarChanged;
        AuthState.AuthenticationStateChanged += OnAuthenticationStateChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The layout outlives the login: the first render may happen while anonymous, so the
        // authenticated avatar is also fetched when the authentication state changes.
        await RefreshAvatarAsync(await AuthState.GetAuthenticationStateAsync());
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> state) =>
        _ = InvokeAsync(async () => await RefreshAvatarAsync(await state));

    private async Task RefreshAvatarAsync(AuthenticationState state)
    {
        _user = state.User;

        if (state.User.Identity?.IsAuthenticated != true)
        {
            _avatarUrl = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var userKey = state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? state.User.Identity.Name;

        await AvatarState.EnsureLoadedAsync(userKey, cancellationToken => Api.GetMyAvatarAsync(cancellationToken));

        _avatarUrl = AvatarState.AvatarUrl;
        await InvokeAsync(StateHasChanged);
    }

    // The sheet belongs to the tab bar: navigating from the list always closes it.
    private void OnLocationChanged(object? sender, EventArgs _) => CloseMore();

    private void ToggleMore() => _moreOpen = !_moreOpen;

    private void CloseMore() => _moreOpen = false;

    private void OnAvatarChanged()
    {
        _avatarUrl = AvatarState.AvatarUrl;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AvatarState.Changed -= OnAvatarChanged;
        AuthState.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();

        // SPA navigation (no page reload): the token is already cleared, so the authentication
        // state drops to anonymous and the login screen takes over. A forceLoad here would race
        // with the redirect fired by the authentication change itself and could take down the
        // UI with an unexpected error.
        Navigation.NavigateTo("/login", replace: true);
    }

    // The highlighted profile is the strongest the account has, in the order of DisplayText.Roles.
    private static string Role(ClaimsPrincipal user) =>
        DisplayText.RoleLabel(DisplayText.Roles.FirstOrDefault(user.IsInRole) ?? "User");
}
